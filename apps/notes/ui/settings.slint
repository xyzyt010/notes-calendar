// Full settings window: appearance, layout, behaviour, security and data.

import { Theme } from "../../shared-ui/theme.slint";
import {
    IconMoon, IconSun, IconLayoutGrid, IconList, IconPanelLeft,
    IconGhost, IconDownload, IconUpload, IconTrash, IconLock, IconUnlock,
    IconEye, IconEyeOff,
} from "../../shared-ui/icons.slint";
import {
    IconButton, TextButton, Divider, NoteCheckBox,
} from "../../shared-ui/components.slint";

// Web .pw-fields input: 50px, 1px border, radius 10, 16px, focus 2px.
// Bare TextInput renders invisible in Slint, so every password field is
// wrapped in a bordered box with a placeholder overlay.
component SettingsPasswordField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "Password";
    in-out property <bool> show: false;

    height: 50px;
    border-radius: 10px;
    background: transparent;
    border-width: field.has-focus ? 2px : 1px;
    border-color: field.has-focus ? Theme.icon : Theme.border;
    clip: true;
    field := TextInput {
        x: 16px;
        width: parent.width - 64px;
        height: 100%;
        input-type: root.show ? InputType.text : InputType.password;
        font-size: 16px;
        color: Theme.text;
        vertical-alignment: center;
        text <=> root.text;
    }
    if root.text == "":
        Text {
            x: 16px;
            width: parent.width - 64px;
            height: 100%;
            text: root.placeholder;
            font-size: 16px;
            color: Theme.text-faint;
            vertical-alignment: center;
        }
    IconButton {
        x: parent.width - 44px;
        y: 7px;
        size: 36px;
        clicked => { root.show = !root.show; }
        if root.show:
            IconEye { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; }
        if !root.show:
            IconEyeOff { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; }
    }
}

// Web .set-check: 18px box, gap 10, label 14px, row padding 9px 0.
component SettingsCheck inherits Rectangle {
    in property <string> label;
    in property <bool> checked: false;
    callback toggled();

    height: 38px;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
    HorizontalLayout {
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 10px;
        VerticalLayout { alignment: center; NoteCheckBox { box-size: 18px; checked: root.checked; toggled => { root.toggled(); } } }
        Text { text: root.label; font-size: 14px; color: Theme.text; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
    }
}

export component SettingsView inherits Rectangle {
    in-out property <bool> dark: true;
    in-out property <bool> neo: false;
    in-out property <int> layout: 0;      // 0 Keep · 1 Notion · 2 Obsidian · 3 Neomorph · 4 Graph
    in-out property <int> density: 1;     // 0 compact · 1 cozy · 2 roomy
    in-out property <bool> mobile-two: true;
    in-out property <int> sort: 0;        // 0 updated · 1 created · 2 title · 3 manual
    in-out property <bool> pinned-first: true;
    in-out property <bool> md-cards: false;
    in-out property <bool> show-dates: false;
    in-out property <int> clamp: 0;
    in-out property <bool> vault-enabled: false;
    in-out property <int> security-mode: 0; // 0 overview · 1 enable · 2 change · 3 reset
    in-out property <string> security-error: "";
    in-out property <string> new-password: "";
    in-out property <string> confirm-password: "";
    in-out property <string> current-password: "";
    in-out property <bool> reset-acknowledged: false;
    in-out property <int> password-strength: 0;
    in-out property <string> stats-text: "";
    in-out property <string> about-version: "1.1.0";

    callback close();
    callback password-edited();
    callback theme-selected(bool);
    callback layout-selected(int);
    callback density-selected(int);
    callback mobile-two-toggled();
    callback sort-selected(int);
    callback pinned-first-toggled();
    callback md-cards-toggled();
    callback show-dates-toggled();
    callback clamp-selected(int);
    callback markdown-guide();
    callback import-md();
    callback export-all();
    callback empty-trash();
    callback create-vault(string, string);
    callback change-password(string, string);
    callback reset-password(string, string, bool);
    callback lock-now();

    width: 100%;
    height: 100%;
    background: Theme.bg;

    changed new-password => { root.password-edited(); }

        Flickable {
            x: (parent.width - self.width) / 2;
            width: min(744px, parent.width);
            height: 100%;
            content-width: self.width;
            content-height: content.preferred-height;
            content := VerticalLayout {
                padding: 24px;
                spacing: 14px;

                HorizontalLayout {
                    height: 36px;
                    Text { text: "Settings"; font-size: 22px; font-weight: 400; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                    TextButton { label: "Done"; emphasis: true; clicked => { root.close(); } }
                }

                // ---------- Theme ----------
                Text { text: "Theme"; font-size: 15px; font-weight: 500; color: Theme.text; }
                HorizontalLayout {
                    spacing: 10px;
                    for choice[i] in [false, true]:
                        Rectangle {
                            height: 82px;
                            horizontal-stretch: 1;
                            border-radius: Theme.r-md;
                            background: Theme.card-bg;
                            border-width: 2px;
                            border-color: (choice == root.dark) ? Theme.text : Theme.border;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.theme-selected(choice); }
                            }
                            VerticalLayout {
                                padding: 10px;
                                spacing: 5px;
                                // Web .tt-prev: mini two-tone preview block.
                                Rectangle {
                                    height: 30px;
                                    border-radius: 6px;
                                    background: choice ? #1F1F1F : #F1F3F4;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    clip: true;
                                    Rectangle { x: 6px; y: 6px; width: 12px; height: 4px; border-radius: 2px; background: choice ? #9aa0a6 : #5f6368; }
                                    Rectangle { x: 6px; y: 14px; width: 18px; height: 4px; border-radius: 2px; background: choice ? #5f6368 : #9aa0a6; }
                                    Rectangle { x: 6px; y: 22px; width: 10px; height: 4px; border-radius: 2px; background: choice ? #3c4043 : #e8eaed; }
                                }
                                Text { text: choice ? "Dark" : "Light"; font-size: 13px; font-weight: 600; color: Theme.text; }
                            }
                        }
                }

                // ---------- View style ----------
                Rectangle { height: 1px; background: Theme.divider; }
                Text { text: "View style"; font-size: 15px; font-weight: 500; color: Theme.text; }
                Text { text: "Applies to Notes, Archive and Trash."; font-size: 11.5px; color: Theme.text-faint; }
                HorizontalLayout {
                    spacing: 8px;
                    for choice[i] in [0, 1, 2, 3, 4]:
                        Rectangle {
                            width: (parent.width - 32px) / 5;
                            height: 94px;
                            border-radius: Theme.r-md;
                            background: Theme.card-bg;
                            border-width: 2px;
                            border-color: root.layout == choice ? Theme.text : Theme.border;
                            TouchArea { mouse-cursor: pointer; clicked => { root.layout-selected(choice); } }
                            VerticalLayout {
                                padding: 7px;
                                spacing: 4px;
                                alignment: center;
                                // Web .vt-prev: mini layout diagram per style.
                                Rectangle {
                                    width: 46px;
                                    height: 30px;
                                    clip: true;
                                    if choice == 0:
                                        Rectangle { x: 0px; y: 0px; width: 20px; height: 12px; border-radius: 2px; background: Theme.surface-3; }
                                        Rectangle { x: 0px; y: 16px; width: 20px; height: 8px; border-radius: 2px; background: Theme.surface-3; }
                                        Rectangle { x: 24px; y: 0px; width: 20px; height: 8px; border-radius: 2px; background: Theme.surface-3; }
                                        Rectangle { x: 24px; y: 12px; width: 20px; height: 12px; border-radius: 2px; background: Theme.surface-3; }
                                    if choice == 1:
                                        Rectangle { x: 0px; y: 2px; width: 46px; height: 4px; border-radius: 2px; background: Theme.surface-3; }
                                        Rectangle { x: 0px; y: 12px; width: 46px; height: 4px; border-radius: 2px; background: Theme.surface-3; }
                                        Rectangle { x: 0px; y: 22px; width: 30px; height: 4px; border-radius: 2px; background: Theme.surface-3; }
                                    if choice == 2:
                                        Rectangle { x: 0px; y: 0px; width: 14px; height: 30px; border-radius: 2px; background: Theme.surface-3; }
                                        Rectangle { x: 17px; y: 0px; width: 29px; height: 30px; border-radius: 2px; background: Theme.surface-2; }
                                    if choice == 3:
                                        Rectangle { x: 7px; y: 1px; width: 32px; height: 28px; border-radius: 8px; background: Theme.surface-3; border-width: 1px; border-color: Theme.border-strong; drop-shadow-blur: 8px; drop-shadow-offset-y: 3px; drop-shadow-color: #00000040; }
                                    if choice == 4:
                                        Rectangle { x: 4px; y: 4px; width: 6px; height: 6px; border-radius: 3px; background: Theme.accent; }
                                        Rectangle { x: 32px; y: 8px; width: 6px; height: 6px; border-radius: 3px; background: Theme.surface-3; }
                                        Rectangle { x: 18px; y: 20px; width: 6px; height: 6px; border-radius: 3px; background: Theme.surface-3; }
                                        Rectangle { x: 7px; y: 7px; width: 1px; height: 13px; background: Theme.border-strong; }
                                        Rectangle { x: 30px; y: 11px; width: 8px; height: 1px; background: Theme.border-strong; }
                                        Rectangle { x: 21px; y: 23px; width: 11px; height: 1px; background: Theme.border-strong; }
                                }
                                Text {
                                    text: choice == 0 ? "Keep" : choice == 1 ? "Notion" : choice == 2 ? "Obsidian" : choice == 3 ? "Neomorph" : "3D graph";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: Theme.text;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: choice == 0 ? "Masonry cards, drag to reorder" : choice == 1 ? "Page rows, single column" : choice == 2 ? "Vault list, full text" : choice == 3 ? "Soft extruded cards" : "Note universe, spatial";
                                    font-size: 8.5px;
                                    color: Theme.text-faint;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }
                }

                // ---------- Density ----------
                Rectangle { height: 1px; background: Theme.divider; }
                Text { text: "Density"; font-size: 15px; font-weight: 500; color: Theme.text; }
                HorizontalLayout {
                    spacing: 6px;
                    for choice[i] in [0, 1, 2]:
                        Rectangle {
                            height: 36px;
                            horizontal-stretch: 1;
                            border-radius: Theme.r-md;
                            background: root.density == choice ? Theme.card-bg : Theme.surface-2;
                            border-width: 1px;
                            border-color: root.density == choice ? Theme.text : transparent;
                            TouchArea { mouse-cursor: pointer; clicked => { root.density-selected(choice); } }
                            Text { text: choice == 0 ? "Compact" : choice == 1 ? "Cozy" : "Roomy"; font-size: 12.5px; font-weight: 600; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                        }
                }
                SettingsCheck { label: "Always two cards per row on phones"; checked: root.mobile-two; toggled => { root.mobile-two-toggled(); } }

                // ---------- Behaviour ----------
                Rectangle { height: 1px; background: Theme.divider; }
                Text { text: "Notes behaviour"; font-size: 15px; font-weight: 500; color: Theme.text; }
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "Order by"; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; width: 54px; }
                    for choice[i] in [0, 1, 2, 3]:
                        Rectangle {
                            height: 32px;
                            horizontal-stretch: 1;
                            border-radius: Theme.r-sm;
                            background: root.sort == choice ? Theme.surface-3 : Theme.surface-2;
                            TouchArea { mouse-cursor: pointer; clicked => { root.sort-selected(choice); } }
                            Text { text: choice == 0 ? "Last edited" : choice == 1 ? "Date created" : choice == 2 ? "Title A–Z" : "Manual (drag order)"; font-size: 11.5px; font-weight: 600; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                        }
                }
                SettingsCheck { label: "Keep pinned notes in their own section"; checked: root.pinned-first; toggled => { root.pinned-first-toggled(); } }
                SettingsCheck { label: "Render markdown inside cards"; checked: root.md-cards; toggled => { root.md-cards-toggled(); } }
                SettingsCheck { label: "Show last-edited date on cards"; checked: root.show-dates; toggled => { root.show-dates-toggled(); } }
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "Preview"; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; width: 54px; }
                    for choice[i] in [3, 5, 6, 8, 0]:
                        Rectangle {
                            height: 32px;
                            horizontal-stretch: 1;
                            border-radius: Theme.r-sm;
                            background: root.clamp == choice ? Theme.surface-3 : Theme.surface-2;
                            TouchArea { mouse-cursor: pointer; clicked => { root.clamp-selected(choice); } }
                            Text { text: choice == 0 ? "Fit content" : choice + " lines"; font-size: 11.5px; font-weight: 600; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                        }
                }

                // ---------- Markdown ----------
                Rectangle { height: 1px; background: Theme.divider; }
                Text { text: "Markdown"; font-size: 15px; font-weight: 500; color: Theme.text; }
                Text { text: "[[Note title]] links notes together and drives the 3D graph."; font-size: 11.5px; color: Theme.text-dim; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    TextButton { label: "Markdown guide"; clicked => { root.markdown-guide(); } }
                    TextButton { label: "Import .md"; clicked => { root.import-md(); } }
                    TextButton { label: "Export all (.md)"; clicked => { root.export-all(); } }
                }

                // ---------- Security ----------
                Rectangle { height: 1px; background: Theme.divider; }
                Text { text: "Security"; font-size: 15px; font-weight: 500; color: Theme.text; }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        width: 42px;
                        height: 42px;
                        border-radius: 12px;
                        background: root.vault-enabled ? Theme.accent-soft : Theme.surface-2;
                        VerticalLayout { alignment: center; HorizontalLayout { alignment: center; if root.vault-enabled: IconLock { stroke-color: Theme.accent; preferred-width: 21px; preferred-height: 21px; } if !root.vault-enabled: IconUnlock { stroke-color: Theme.text-dim; preferred-width: 21px; preferred-height: 21px; } } }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text { text: root.vault-enabled ? "End-to-end encryption is on" : "Vault is not enabled"; font-size: 13px; font-weight: 650; color: Theme.text; }
                        Text { text: root.vault-enabled ? "Titles, bodies, tags and attachments are AES-256-GCM encrypted on this device." : "Your notes are stored as plaintext until you set an encryption password."; font-size: 10.5px; color: Theme.text-dim; wrap: word-wrap; }
                    }
                }
                if root.security-mode == 0 && !root.vault-enabled:
                    TextButton { label: "Set encryption password"; emphasis: true; clicked => { root.security-mode = 1; root.security-error = ""; } }
                if root.security-mode == 0 && root.vault-enabled:
                    HorizontalLayout {
                        spacing: 8px;
                        TextButton { label: "Change password"; clicked => { root.security-mode = 2; root.security-error = ""; } }
                        TextButton { label: "Reset password"; danger: true; clicked => { root.security-mode = 3; root.security-error = ""; } }
                        TextButton { label: "Lock now"; clicked => { root.lock-now(); } }
                    }
                if root.security-mode == 1:
                    Rectangle { border-radius: Theme.r-md; background: Theme.surface-2; VerticalLayout { padding: 16px; spacing: 12px; Text { text: "Set an encryption password. Every note is re-encrypted to this device's key."; font-size: 13px; color: Theme.text-dim; wrap: word-wrap; } SettingsPasswordField { placeholder: "New password (min 8 characters)"; text <=> root.new-password; } SettingsPasswordField { placeholder: "Confirm new password"; text <=> root.confirm-password; }
                        // Web strength meter (keep-app.js): 4 segments by length.
                        HorizontalLayout {
                            spacing: 4px;
                            for b[i] in 4:
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: (b + 1) <= root.password-strength ? Theme.accent : Theme.surface-3;
                                }
                        }
                        if root.security-error != "": Text { text: root.security-error; font-size: 11px; color: Theme.danger; } HorizontalLayout { alignment: end; spacing: 6px; TextButton { label: "Cancel"; clicked => { root.security-mode = 0; } } TextButton { label: "Encrypt notes"; emphasis: true; clicked => { root.create-vault(root.new-password, root.confirm-password); } } } } }
                if root.security-mode == 2:
                    Rectangle { border-radius: Theme.r-md; background: Theme.surface-2; VerticalLayout { padding: 16px; spacing: 12px; Text { text: "Proves the current password, then re-encrypts every note to the new key on this device. Keep this window open until it finishes."; font-size: 13px; color: Theme.text-dim; wrap: word-wrap; } SettingsPasswordField { placeholder: "Current password"; text <=> root.current-password; } SettingsPasswordField { placeholder: "New password (min 8 characters)"; text <=> root.new-password; } SettingsPasswordField { placeholder: "Confirm new password"; text <=> root.confirm-password; } if root.security-error != "": Text { text: root.security-error; font-size: 11px; color: Theme.danger; } HorizontalLayout { alignment: end; spacing: 6px; TextButton { label: "Cancel"; clicked => { root.security-mode = 0; } } TextButton { label: "Change"; emphasis: true; clicked => { root.change-password(root.current-password, root.new-password); } } } } }
                if root.security-mode == 3:
                    Rectangle { border-radius: Theme.r-md; background: Theme.surface-2; VerticalLayout { padding: 16px; spacing: 12px; Text { text: "Because this device already holds your encryption key, you can set a new password without the old one. Other devices stay locked until they use the new password."; font-size: 13px; color: Theme.text-dim; wrap: word-wrap; } SettingsPasswordField { placeholder: "New password (min 8 characters)"; text <=> root.new-password; } SettingsPasswordField { placeholder: "Confirm new password"; text <=> root.confirm-password; } SettingsCheck { label: "I understand other devices lose access and there is no server-side recovery."; checked: root.reset-acknowledged; toggled => { root.reset-acknowledged = !root.reset-acknowledged; } } if root.security-error != "": Text { text: root.security-error; font-size: 11px; color: Theme.danger; } HorizontalLayout { alignment: end; spacing: 6px; TextButton { label: "Cancel"; clicked => { root.security-mode = 0; } } TextButton { label: "Reset"; danger: true; clicked => { root.reset-password(root.new-password, root.confirm-password, root.reset-acknowledged); } } } } }

                // ---------- Data ----------
                Rectangle { height: 1px; background: Theme.divider; }
                Text { text: "Data"; font-size: 15px; font-weight: 500; color: Theme.text; }
                Text { text: root.stats-text; font-size: 11.5px; color: Theme.text-dim; wrap: word-wrap; }
                TextButton { label: "Empty trash"; danger: true; clicked => { root.empty-trash(); } }

                // ---------- About ----------
                Rectangle { height: 1px; background: Theme.divider; }
                Text { text: "About"; font-size: 15px; font-weight: 500; color: Theme.text; }
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle { width: 44px; height: 44px; border-radius: 12px; background: Theme.accent-soft; HorizontalLayout { alignment: center; IconGhost { stroke-color: Theme.accent; preferred-width: 26px; preferred-height: 26px; } } }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "Notes · yellod suite"; font-size: 13px; font-weight: 650; color: Theme.text; }
                        Text { text: "Version " + root.about-version + " · local-first, private by design"; font-size: 11px; color: Theme.text-faint; }
                    }
                }
            }
    }
}

// Obsidian-style vault view: searchable note list + markdown reading pane.

import { Theme } from "../../shared-ui/theme.slint";
import {
    IconPin, IconPinFilled, IconPencil, IconExternalLink, IconSearch, IconPlus,
} from "../../shared-ui/icons.slint";
import {
    IconButton, NoteData, TextButton,
} from "../../shared-ui/components.slint";

export component VaultView inherits Rectangle {
    in-out property <string> filter: "";
    in-out property <bool> source-mode: false;
    in-out property <[NoteData]> notes: [];
    in property <string> selected-id: "";
    in property <bool> has-note: false;
    in-out property <string> doc-title: "";
    in-out property <string> doc-meta: "";
    in property <styled-text> doc-markdown;
    in-out property <string> doc-source: "";
    in-out property <[string]> links-out: [];
    in-out property <[string]> backlinks: [];
    in property <bool> pinned: false;

    callback filter-changed(string);
    callback note-selected(string);
    callback new-note();
    callback pin-toggled();
    callback edit-source();
    callback source-edited();
    callback open-note();
    callback link-clicked(string);
    callback title-edited(string);

    background: Theme.bg;

    HorizontalLayout {
        // ===== List sidebar =====
        Rectangle {
            width: 260px;
            background: Theme.surface;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    height: 36px;
                    Text { text: "VAULT"; font-size: 13px; font-weight: 500; letter-spacing: 0.52px; color: Theme.text-dim; vertical-alignment: center; horizontal-stretch: 1; }
                    IconButton { size: 44px; clicked => { root.new-note(); } IconPlus { stroke-color: Theme.icon; preferred-width: 22px; preferred-height: 22px; } }
                }
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: Theme.bg;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 8px;
                        VerticalLayout { alignment: center; IconSearch { stroke-color: Theme.text-faint; preferred-width: 16px; preferred-height: 16px; } }
                        TextInput {
                            text <=> root.filter;
                            font-size: 13px;
                            color: Theme.text;
                            vertical-alignment: center;
                            selection-background-color: Theme.accent-soft;
                            edited => { root.filter-changed(self.text); }
                            horizontal-stretch: 1;
                        }
                    }
                }
                Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: listColumn.preferred-height;
                    listColumn := VerticalLayout {
                        spacing: 4px;
                        for note[i] in root.notes:
                            row := Rectangle {
                                height: 36px;
                                background: note.id == root.selected-id ? (Theme.dark ? Theme.bg : #FFFFFF) : (rowTouch.has-hover ? Theme.icon-hover-bg : transparent);
                                rowTouch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.note-selected(note.id); }
                                }
                                Rectangle { x: 0px; y: 0px; width: note.id == root.selected-id ? 2px : 0px; height: 100%; background: Theme.text; }
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 14px;
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: center;
                                        if note.pinned:
                                            IconPinFilled { stroke-color: Theme.text; preferred-width: 14px; preferred-height: 14px; }
                                        if !note.pinned:
                                            Rectangle { width: 14px; height: 14px; }
                                    }
                                    Text {
                                        text: note.title == "" ? "Untitled" : note.title;
                                        font-size: 13.5px;
                                        font-weight: note.id == root.selected-id ? 500 : 400;
                                        color: Theme.text;
                                        wrap: no-wrap;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    if note.image-count > 0:
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 26px;
                                                height: 18px;
                                                border-radius: 5px;
                                                background: Theme.icon-hover-bg;
                                                Text { text: note.image-count + ""; font-size: 11px; color: Theme.text-dim; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                        }
                                }
                            }
                        if root.notes.length == 0:
                            Text {
                                text: "No notes match this filter";
                                color: Theme.text-faint;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                    }
                }
            }
        }
        Rectangle { width: 1px; background: Theme.border; }

        // ===== reading pane =====
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg;
            if !root.has-note:
                VerticalLayout {
                    alignment: center;
                    Text { text: "Select a note to read it as a document"; font-size: 15px; color: Theme.text-faint; horizontal-alignment: center; }
                }
            if root.has-note:
                Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: docColumn.preferred-height;
                    docColumn := VerticalLayout {
                        padding-left: 34px;
                        padding-right: 34px;
                        padding-top: 24px;
                        padding-bottom: 28px;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 8px;
                            TextInput {
                                text <=> root.doc-title;
                                font-size: 28px;
                                font-weight: 500;
                                color: Theme.text;
                                letter-spacing: -0.4px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                selection-background-color: Theme.accent-soft;
                                edited => { root.title-edited(self.text); }
                            }
                            IconButton { size: 44px; clicked => { root.pin-toggled(); } if root.pinned: IconPinFilled { stroke-color: Theme.text; preferred-width: 22px; preferred-height: 22px; } if !root.pinned: IconPin { stroke-color: Theme.icon; preferred-width: 22px; preferred-height: 22px; } }
                            IconButton { size: 44px; clicked => { root.edit-source(); } IconPencil { stroke-color: Theme.icon; preferred-width: 22px; preferred-height: 22px; } }
                            IconButton { size: 44px; clicked => { root.open-note(); } IconExternalLink { stroke-color: Theme.icon; preferred-width: 22px; preferred-height: 22px; } }
                        }
                        Text {
                            text: root.doc-meta;
                            font-size: 11.5px;
                            color: Theme.text-faint;
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        if !root.source-mode:
                            StyledText {
                                text: root.doc-markdown;
                                default-color: Theme.text;
                                link-color: Theme.accent;
                                default-font-size: 15px;
                            }
                        if root.source-mode:
                            TextInput {
                                text <=> root.doc-source;
                                single-line: false;
                                wrap: word-wrap;
                                preferred-height: 460px;
                                font-size: 14px;
                                color: Theme.text;
                                selection-background-color: Theme.accent-soft;
                                edited => { root.source-edited(); }
                            }
                        HorizontalLayout {
                            spacing: 24px;
                            VerticalLayout {
                                spacing: 6px;
                                horizontal-stretch: 1;
                                Text { text: "LINKS OUT"; font-size: 12px; font-weight: 500; letter-spacing: 0.48px; color: Theme.text-dim; }
                                for link[i] in root.links-out:
                                    TextButton { label: "[[" + link + "]]"; clicked => { root.link-clicked(link); } }
                                if root.links-out.length == 0:
                                    Text { text: "None yet"; font-size: 12px; color: Theme.text-faint; }
                            }
                            VerticalLayout {
                                spacing: 6px;
                                horizontal-stretch: 1;
                                Text { text: "BACKLINKS"; font-size: 12px; font-weight: 500; letter-spacing: 0.48px; color: Theme.text-dim; }
                                for link[i] in root.backlinks:
                                    TextButton { label: link; clicked => { root.link-clicked(link); } }
                                if root.backlinks.length == 0:
                                    Text { text: "None yet"; font-size: 12px; color: Theme.text-faint; }
                            }
                        }
                    }
                }
        }
    }
}

// Freehand doodle overlay. Rust records the strokes and rasterizes them to a PNG.

import { Theme } from "../../shared-ui/theme.slint";
import {
    IconX, IconDoodleUndo, IconTrash, IconCheck,
} from "../../shared-ui/icons.slint";
import {
    IconButton, DoodleStrokeData, TextButton,
} from "../../shared-ui/components.slint";

export component DoodleOverlay inherits Rectangle {
    in property <[DoodleStrokeData]> strokes: [];
    in-out property <color> pen-color: #202124;
    in-out property <length> pen-size: 4px;

    callback draw-down(length, length, bool);
    callback draw-move(length, length, bool);
    callback draw-up(length, length);
    callback undo();
    callback clear();
    callback cancel();
    callback save();

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(920px, parent.width - 32px);
        height: min(660px, parent.height - 32px);
        border-radius: Theme.r-md;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 34px;
        drop-shadow-color: #00000080;

        VerticalLayout {
            padding: 12px;
            spacing: 10px;
            HorizontalLayout {
                height: 40px;
                Text { text: "Doodle"; font-size: 16px; font-weight: 500; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                for color[i] in [#202124, #EA4335, #F9AB00, #34A853, #1A73E8, #A142F4, #FFFFFF]:
                    TouchArea {
                        width: 28px;
                        height: 28px;
                        mouse-cursor: pointer;
                        clicked => { root.pen-color = color; }
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            y: 2px;
                            x: 2px;
                            border-radius: 12px;
                            background: color;
                            border-width: root.pen-color == color ? 4px : 0px;
                            border-color: Theme.text;
                        }
                    }
                Rectangle { width: 8px; }
                for size[i] in [2px, 4px, 8px, 14px]:
                    TouchArea {
                        width: 30px;
                        height: 26px;
                        mouse-cursor: pointer;
                        clicked => { root.pen-size = size; }
                        Rectangle {
                            x: (parent.width - size) / 2;
                            y: (parent.height - size) / 2;
                            width: size;
                            height: size;
                            border-radius: size / 2;
                            background: root.pen-color;
                        }
                    }
                IconButton { size: 44px; clicked => { root.undo(); } IconDoodleUndo { stroke-color: Theme.icon; preferred-width: 22px; preferred-height: 22px; } }
                IconButton { size: 44px; clicked => { root.clear(); } IconTrash { stroke-color: Theme.icon; preferred-width: 22px; preferred-height: 22px; } }
            }

            paper := Rectangle {
                vertical-stretch: 1;
                border-radius: Theme.r-md;
                background: #FFFFFF;
                clip: true;

                drawArea := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: crosshair;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            root.draw-down(self.mouse-x, self.mouse-y, event.modifiers.shift);
                            return EventResult.accept;
                        }
                        if event.kind == PointerEventKind.move && self.pressed {
                            root.draw-move(self.mouse-x, self.mouse-y, event.modifiers.shift);
                            return EventResult.accept;
                        }
                        if event.kind == PointerEventKind.up {
                            root.draw-up(self.mouse-x, self.mouse-y);
                            return EventResult.accept;
                        }
                        return EventResult.reject;
                    }
                }

                for stroke[i] in root.strokes:
                    Path {
                        x: 0;
                        y: 0;
                        viewbox-width: parent.width / 1px;
                        viewbox-height: parent.height / 1px;
                        fit: preserve;
                        commands: stroke.commands;
                        stroke: stroke.color;
                        stroke-width: stroke.size;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                        fill: transparent;
                    }
            }

            HorizontalLayout {
                height: 38px;
                Text { text: "drag to draw · Ctrl+Z undoes · Cancel or Esc leaves it unsaved"; font-size: 11px; color: Theme.text-faint; vertical-alignment: center; horizontal-stretch: 1; }
                TextButton { label: "Cancel"; clicked => { root.cancel(); } }
                TextButton { label: "Add to note"; emphasis: true; clicked => { root.save(); } }
            }
        }
    }
}

// New-note composer card (Keep-style): collapsed placeholder expands into an
// editor with pin, colour, images, doodle, checklist and markdown preview.

import { Theme } from "../../shared-ui/theme.slint";
import {
    IconPin, IconPinFilled, IconPalette, IconImage, IconPencil, IconSquareCheck,
    IconMarkdown, IconX, IconTrash, IconPlus,
} from "../../shared-ui/icons.slint";
import {
    IconButton, NoteImageData, ChecklistItemData, TextButton, NoteCheckBox,
} from "../../shared-ui/components.slint";

export component NewNoteComposer inherits Rectangle {
    in-out property <bool> open: false;
    in-out property <bool> color-popover-open: false;
    in-out property <string> title: "";
    in-out property <string> body: "";
    in-out property <bool> pinned: false;
    in-out property <int> color-index: 0;
    in-out property <bool> checklist-mode: false;
    in-out property <bool> preview-mode: false;
    in-out property <[ChecklistItemData]> checklist-items: [];
    in-out property <[NoteImageData]> pending-images: [];
    in property <styled-text> preview-styled;

    callback open-requested();
    callback close-requested();
    callback content-changed();
    callback toggle-pin();
    callback color-picked(int);
    callback image-requested();
    callback draw-requested();
    callback checklist-toggle();
    callback checklist-add(string);
    callback checklist-toggle-item(int);
    callback checklist-edit-item(int, string);
    callback checklist-remove-item(int);
    callback preview-toggle();
    callback remove-pending-image(string);

    background: Theme.card-bg;
    border-radius: Theme.r-md;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 3px;
    drop-shadow-color: #00000040;

    // ===== composer (always expanded, like the webapp) =====
    VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 14px;
            padding-bottom: 10px;
            spacing: 6px;

            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 100%;
                    TextInput {
                        width: 100%;
                        height: 100%;
                        text <=> root.title;
                        font-size: 16px;
                        font-weight: 500;
                        color: Theme.text;
                        vertical-alignment: center;
                        selection-background-color: Theme.accent-soft;
                        edited => { root.content-changed(); }
                    }
                    if root.title == "":
                        Text { width: 100%; height: 100%; vertical-alignment: center; text: "Title"; font-size: 16px; color: Theme.placeholder; wrap: no-wrap; }
                }
                IconButton {
                    size: 44px;
                    clicked => { root.toggle-pin(); }
                    if root.pinned:
                        IconPinFilled { stroke-color: Theme.text; preferred-width: 22px; preferred-height: 22px; }
                    if !root.pinned:
                        IconPin { stroke-color: Theme.icon; preferred-width: 22px; preferred-height: 22px; }
                }
            }

            if !root.checklist-mode && !root.preview-mode:
                Rectangle {
                    height: 48px;
                    bodyInput := TextInput {
                        width: 100%;
                        height: 100%;
                        text <=> root.body;
                        single-line: false;
                        wrap: word-wrap;
                        font-size: 16px;
                        color: Theme.text;
                        selection-background-color: Theme.accent-soft;
                        edited => { root.content-changed(); }
                    }
                    if root.body == "":
                        Text { width: 100%; height: 100%; vertical-alignment: center; text: "Take a note… (Markdown supported)"; font-size: 16px; color: Theme.placeholder; wrap: no-wrap; }
                }
            if root.preview-mode:
                previewPane := Rectangle {
                    preferred-height: 82px;
                    StyledText {
                        text: root.preview-styled;
                        default-color: Theme.text;
                        link-color: Theme.accent;
                        default-font-size: 13px;
                    }
                }
            if root.checklist-mode:
                checklistScroll := Flickable {
                    preferred-height: 108px;
                    content-height: checklistColumn.preferred-height;
                    checklistColumn := VerticalLayout {
                        spacing: 4px;
                        for item[i] in root.checklist-items:
                            Rectangle {
                                height: 40px;
                                checkRow := HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout { alignment: center; NoteCheckBox { checked: item.checked; toggled => { root.checklist-toggle-item(item.line); } } }
                                    TextInput {
                                        text: item.text;
                                        font-size: 15px;
                                        color: item.checked ? Theme.text-faint : Theme.text;
                                        vertical-alignment: center;
                                        edited => { root.checklist-edit-item(item.line, self.text); }
                                        horizontal-stretch: 1;
                                    }
                                    IconButton { size: 30px; clicked => { root.checklist-remove-item(item.line); } IconTrash { stroke-color: Theme.icon; preferred-width: 16px; preferred-height: 16px; } }
                                }
                            }
                        addRow := HorizontalLayout {
                            height: 36px;
                            spacing: 10px;
                            VerticalLayout { alignment: center; IconPlus { stroke-color: Theme.text-dim; preferred-width: 18px; preferred-height: 18px; } }
                            TextInput {
                                font-size: 13px;
                                color: Theme.text;
                                vertical-alignment: center;
                                key-pressed(event) => {
                                    if event.text == "\n" { root.checklist-add(self.text); self.text = ""; return accept; }
                                    reject
                                }
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }

            if root.pending-images.length > 0:
                HorizontalLayout {
                    height: 78px;
                    spacing: 8px;
                    for pending[i] in root.pending-images:
                        Rectangle {
                            width: 104px;
                            height: 72px;
                            border-radius: Theme.r-sm;
                            background: Theme.surface-2;
                            Image {
                                source: pending.thumbnail;
                                width: 100%;
                                height: 100%;
                                image-fit: contain;
                            }
                            IconButton {
                                x: parent.width - 26px;
                                y: 2px;
                                size: 22px;
                                clicked => { root.remove-pending-image(pending.id); }
                                IconX { stroke-color: #ffffff; preferred-width: 12px; preferred-height: 12px; }
                            }
                        }
                }

            HorizontalLayout {
                spacing: 2px;
                IconButton { size: 40px; clicked => { root.color-popover-open = !root.color-popover-open; } IconPalette { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
                IconButton { size: 40px; clicked => { root.image-requested(); } IconImage { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
                IconButton { size: 40px; clicked => { root.draw-requested(); } IconPencil { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
                IconButton { selected: root.checklist-mode; size: 40px; clicked => { root.checklist-toggle(); } IconSquareCheck { stroke-color: root.checklist-mode ? Theme.text : Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
                IconButton { selected: root.preview-mode; size: 40px; clicked => { root.preview-toggle(); } IconMarkdown { stroke-color: root.preview-mode ? Theme.text : Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
                Rectangle {}
                TextButton { label: "Close"; text-only: true; clicked => { root.close-requested(); } }
            }
        }

    if root.color-popover-open:
        Rectangle {
            width: 100%;
            height: 100%;
            TouchArea { clicked => { root.color-popover-open = false; } }
            Rectangle {
                x: 8px;
                y: parent.height - 114px;
                width: 278px;
                height: 106px;
                border-radius: 12px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 2px;
                drop-shadow-color: #00000060;
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 12px;
                        for idx[i] in [0, 1, 2, 3, 4, 5]:
                            TouchArea {
                                width: 31px;
                                height: 31px;
                                mouse-cursor: pointer;
                                clicked => { root.color-picked(idx); root.color-popover-open = false; }
                                Rectangle {
                                    width: 31px;
                                    height: 31px;
                                    border-radius: 8px;
                                    background: Theme.note-color(idx);
                                    border-width: 1px;
                                    border-color: Theme.border;
                                }
                            }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        for idx[i] in [6, 7, 8, 9, 10, 11]:
                            TouchArea {
                                width: 31px;
                                height: 31px;
                                mouse-cursor: pointer;
                                clicked => { root.color-picked(idx); root.color-popover-open = false; }
                                Rectangle {
                                    width: 31px;
                                    height: 31px;
                                    border-radius: 8px;
                                    background: Theme.note-color(idx);
                                    border-width: 1px;
                                    border-color: Theme.border;
                                }
                            }
                    }
                }
            }
        }
}

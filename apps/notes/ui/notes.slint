                    SettingsView {
                        dark <=> root.dark;
                        neo <=> root.neo;
                        layout <=> root.layout-style;
                        density <=> root.density-setting;
                        mobile-two <=> root.mobile-two;
                        sort <=> root.sort-setting;
                        pinned-first <=> root.pinned-first;
                        md-cards <=> root.md-cards;
                        show-dates <=> root.show-dates;
                        clamp <=> root.card-clamp;
                        vault-enabled: root.vault-enabled;
                        security-error <=> root.settings-security-error;
                        stats-text: root.settings-stats;
                        about-version: "1.1.0";
                        close => { root.show-settings = false; }
                        theme-selected(choice) => { if choice != Theme.dark { root.toggle-theme(); } }
                        layout-selected(choice) => { root.layout-selected(choice); }
                        density-selected(choice) => { root.settings-density-selected(choice); }
                        mobile-two-toggled => { root.settings-toggle-mobile-two(); }
                        sort-selected(choice) => { root.settings-sort-selected(choice); }
                        pinned-first-toggled => { root.settings-toggle-pinned-first(); }
                        md-cards-toggled => { root.settings-toggle-md-cards(); }
                        show-dates-toggled => { root.settings-toggle-show-dates(); }

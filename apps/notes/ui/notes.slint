// yellod Notes — main window.
// Top bar → rail → board/vault/graph → status bar; editor as a modal on desktop.

import { Theme } from "../../shared-ui/theme.slint";
import { AboutSlint } from "std-widgets.slint";
import {
    IconGhost, IconMenu, IconPlus, IconPin, IconStar, IconArchive, IconTrash,
    IconSettings, IconMoon, IconSun, IconLayoutGrid, IconList,
    IconFileText, IconFolder, IconFolderPlus, IconTag, IconPanelLeft, IconLink2, IconLock,
} from "../../shared-ui/icons.slint";
import {
    SearchBar, IconButton, RailButton, SidebarRow, Divider, ConfirmDialog,
    Toast, NoteData, FolderData, TagData, TextButton, EmptyState,
    NoteImageData, ChecklistItemData, GraphNodeData, GraphLinkData, DoodleStrokeData,
} from "../../shared-ui/components.slint";
import { NoteListPanel } from "note-grid.slint";
import { EditorPane } from "editor.slint";
import { NewNoteComposer } from "composer.slint";
import { VaultView } from "vault-view.slint";
import { GraphView } from "graph-view.slint";
import { UnlockOverlay } from "unlock.slint";
import { SettingsView } from "settings.slint";
import { MarkdownGuide } from "markdown-guide.slint";
import { DoodleOverlay } from "doodle.slint";


export component MainWindow inherits Window {
    title: "Notes";
    icon: @image-url("../../../assets/app-icon.png");
    default-font-family: "Inter";
    background: Theme.bg;
    preferred-width: 1040px;
    preferred-height: 600px;
    height: 600px;

    // ---------- Rust-facing state ----------
    in-out property <bool> dark: true;
    in-out property <bool> neo: false;
    in-out property <[NoteData]> pinned-notes: [];
    in-out property <[NoteData]> notes: [];
    in-out property <[NoteData]> pinned-col-0: [];
    in-out property <[NoteData]> pinned-col-1: [];
    in-out property <[NoteData]> pinned-col-2: [];
    in-out property <[NoteData]> pinned-col-3: [];
    in-out property <[NoteData]> pinned-col-4: [];
    in-out property <[NoteData]> notes-col-0: [];
    in-out property <[NoteData]> notes-col-1: [];
    in-out property <[NoteData]> notes-col-2: [];
    in-out property <[NoteData]> notes-col-3: [];
    in-out property <[NoteData]> notes-col-4: [];
    in-out property <[FolderData]> folders: [];
    in-out property <[TagData]> tags: [];
    in-out property <string> selected-id: "";
    in-out property <int> active-view: 0;
    in-out property <string> active-folder: "";
    in-out property <string> active-tag: "";
    in-out property <string> search-text: "";
    in-out property <int> search-focus-token: 0;
    in-out property <bool> list-view: false;
    in-out property <int> layout-style: 0;   // 0 Keep · 1 Notion · 2 Obsidian · 3 Neomorph · 4 Graph
    in-out property <int> density-setting: 1;
    in-out property <bool> mobile-two: true;
    in-out property <int> sort-setting: 0;
    in-out property <bool> pinned-first: true;
    in-out property <bool> md-cards: false;
    in-out property <bool> show-dates: true;
    in-out property <int> card-clamp: 5;
    in-out property <int> note-count: 0;
    in-out property <int> grid-cols: 4;
    in-out property <bool> sidebar-open: false;
    in-out property <bool> compact: false;
    in-out property <bool> pinned-section: false;
    in-out property <string> selected-folder-of-editor: "";
    in-out property <bool> new-folder-open: false;
    in-out property <string> new-folder-name: "";

    // Editor state
    in-out property <bool> has-note: false;
    in-out property <string> editor-title: "";
    in-out property <string> editor-body: "";
    in-out property <[string]> editor-tags: [];
    in-out property <bool> editor-pinned: false;
    in-out property <bool> editor-favorite: false;
    in-out property <int> word-count: 0;
    in-out property <int> save-state: 0;
    in-out property <string> edited-label: "";
    in-out property <bool> folder-menu-open: false;
    in-out property <bool> color-popover-open: false;
    in-out property <int> current-note-color-index: 0;
    in-out property <[NoteImageData]> current-images: [];
    in-out property <int> current-image-count: 0;
    in-out property <[ChecklistItemData]> checklist-items: [];
    in-out property <[string]> editor-links: [];
    in property <styled-text> editor-markdown;
    in-out property <int> editor-mode: 0;
    in-out property <bool> editor-checklist-mode: false;
    in-out property <bool> editor-find-open: false;
    in-out property <string> editor-find-query: "";
    in-out property <int> editor-find-count: 0;
    in-out property <int> editor-find-index: 0;
    in-out property <[string]> editor-suggestions: [];
    in-out property <bool> editor-suggestions-visible: false;

    in-out property <int> find-selection-offset: 0;
    in-out property <int> find-selection-length: 0;
    in-out property <int> find-selection-token: 0;

    // Composer state
    in-out property <bool> composer-open: false;
    in-out property <string> composer-title: "";
    in-out property <string> composer-body: "";
    in-out property <bool> composer-pinned: false;
    in-out property <int> composer-color-index: 0;
    in-out property <bool> composer-checklist-mode: false;
    in-out property <bool> composer-preview-mode: false;
    in-out property <[ChecklistItemData]> composer-checklist-items: [];
    in property <styled-text> composer-preview-styled;
    in-out property <[NoteImageData]> composer-pending-images: [];
    in-out property <bool> composer-color-popover-open: false;

    // Vault / unlock state
    in-out property <bool> vault-enabled: false;
    in-out property <bool> vault-unlocked: true;
    in-out property <bool> vault-mismatch: false;
    in-out property <int> vault-mode: 1;
    in-out property <string> vault-password: "";
    in-out property <string> vault-confirm: "";
    in-out property <string> vault-error: "";
    in-out property <bool> vault-show-password: false;

    // Vault view state
    in-out property <string> vault-filter: "";
    in-out property <[NoteData]> vault-notes: [];
    in-out property <string> vault-selected-id: "";
    in-out property <bool> vault-has-note: false;
    in-out property <string> vault-title: "";
    in-out property <string> vault-meta: "";
    in property <styled-text> vault-markdown;
    in-out property <string> vault-source: "";
    in-out property <bool> vault-source-mode: false;
    in-out property <[string]> vault-links-out: [];
    in-out property <[string]> vault-backlinks: [];
    in-out property <bool> vault-pinned: false;

    // Graph state
    in-out property <[GraphNodeData]> graph-nodes: [];
    in-out property <[GraphLinkData]> graph-links: [];
    in-out property <bool> graph-has-selection: false;
    in-out property <string> graph-selected-id: "";
    in-out property <string> graph-selected-title: "";
    in-out property <string> graph-selected-meta: "";
    in property <styled-text> graph-selected-markdown;
    in-out property <[string]> graph-selected-links: [];

    // Doodle state
    in-out property <bool> doodle-open: false;
    in-out property <[DoodleStrokeData]> doodle-strokes: [];
    in-out property <color> doodle-pen-color: #5dd8ff;
    in-out property <length> doodle-pen-size: 5px;

    // Settings / overlays
    in-out property <bool> show-settings: false;
    in-out property <bool> show-markdown-guide: false;
    in-out property <bool> timestamps-open: false;
    in-out property <string> timestamp-created: "";
    in-out property <string> timestamp-edited: "";
    in-out property <[string]> timestamp-activity: [];
    in-out property <bool> show-delete-forever: false;
    in-out property <bool> show-empty-trash: false;
    in-out property <bool> image-preview-open: false;
    in-out property <string> image-preview-id: "";
    in-out property <image> image-preview-image;
    in-out property <string> image-preview-name: "";
    in-out property <string> image-preview-size: "";
    in-out property <string> settings-security-error: "";
    in-out property <string> settings-stats: "";
    in-out property <string> toast-message: "";
    in-out property <bool> toast-visible: false;

    // ---------- Rust-facing actions ----------
    callback new-note();
    callback search-changed(string);
    callback view-selected(int);
    callback folder-selected(string);
    callback new-folder();
    callback create-folder(string);
    callback cancel-new-folder();
    callback delete-folder(string);
    callback tag-selected(string);
    callback note-activated(string);
    callback pin-toggled(string);
    callback manual-note-moved(string, int);
    callback archive-editor();
    callback trash-editor();
    callback restore-editor();
    callback delete-forever-confirmed();
    callback empty-trash-confirmed();
    callback copy-editor();
    callback export-editor();
    callback editor-content-changed();
    callback tag-added(string);
    callback tag-removed(string);
    callback assign-folder(string);
    callback color-picked(int);
    callback toggle-sidebar();
    callback toggle-view-mode();
    callback toggle-theme();
    callback toggle-pin-editor();
    callback toggle-favorite-editor();
    callback back-to-list();
    callback layout-selected(int);
    callback vault-unlock();
    callback vault-create-from-unlock();
    callback vault-forgot();
    callback lock-now();
    callback create-vault(string, string);
    callback change-password(string, string);
    callback reset-password(string, string, bool);
    callback composer-open-requested();
    callback composer-close-requested();
    callback composer-content-changed();
    callback composer-toggle-pin();
    callback composer-color-picked(int);
    callback composer-image-requested();
    callback composer-draw-requested();
    callback composer-checklist-toggle();
    callback composer-preview-toggle();
    callback composer-checklist-add(string);
    callback composer-checklist-toggle-item(int);
    callback composer-checklist-edit-item(int, string);
    callback composer-checklist-remove-item(int);
    callback composer-remove-pending-image(string);
    callback attach-images();
    callback draw-editor();
    callback image-preview(string);
    callback image-delete(string);
    callback image-download-preview();
    callback close-image-preview();
    callback checklist-toggle();
    callback checklist-add(string);
    callback checklist-toggle-item(int);
    callback checklist-edit-item(int, string);
    callback checklist-remove-item(int);
    callback link-clicked(string);
    callback find-changed();
    callback find-next();
    callback find-previous();
    callback close-find();
    callback suggestion-picked(string);
    callback vault-filter-changed(string);
    callback vault-note-selected(string);
    callback vault-new-note();
    callback vault-pin-toggled();
    callback vault-edit-source();
    callback vault-source-edited();
    callback vault-open();
    callback vault-title-edited(string);
    callback graph-pointer-down(length, length, bool);
    callback graph-pointer-move(length, length, bool);
    callback graph-pointer-up(length, length, bool);
    callback graph-wheel(length, bool);
    callback graph-relabel();
    callback graph-close-selection();
    callback graph-open-note();
    callback graph-unlink-all();
    callback doodle-draw-down(length, length, bool);
    callback doodle-draw-move(length, length, bool);
    callback doodle-draw-up(length, length);
    callback doodle-undo();
    callback doodle-clear();
    callback doodle-cancel();
    callback doodle-save();
    callback show-timestamps();
    callback markdown-guide();
    callback import-md();
    callback export-all-md();
    callback settings-density-selected(int);
    callback settings-sort-selected(int);
    callback settings-toggle-mobile-two();
    callback settings-toggle-pinned-first();
    callback settings-toggle-md-cards();
    callback settings-toggle-show-dates();
    callback settings-clamp-selected(int);

    changed width => {
        root.compact = self.width < 880px;
        if root.density-setting == 0 {
            root.grid-cols = self.width < 880px ? (root.mobile-two ? 2 : 1) : self.width < 1250px ? 3 : self.width < 1650px ? 4 : 5;
        } else if root.density-setting == 2 {
            root.grid-cols = self.width < 1100px ? 1 : self.width < 1500px ? 2 : 3;
        } else {
            root.grid-cols = self.width < 880px ? (root.mobile-two ? 2 : 1) : self.width < 1250px ? 2 : self.width < 1650px ? 3 : 4;
        }
    }
    changed density-setting => {
        if root.density-setting == 0 {
            root.grid-cols = self.width < 880px ? (root.mobile-two ? 2 : 1) : self.width < 1250px ? 3 : self.width < 1650px ? 4 : 5;
        } else if root.density-setting == 2 {
            root.grid-cols = self.width < 1100px ? 1 : self.width < 1500px ? 2 : 3;
        } else {
            root.grid-cols = self.width < 880px ? (root.mobile-two ? 2 : 1) : self.width < 1250px ? 2 : self.width < 1650px ? 3 : 4;
        }
    }
    changed mobile-two => {
        if root.density-setting == 0 {
            root.grid-cols = self.width < 880px ? (root.mobile-two ? 2 : 1) : self.width < 1250px ? 3 : self.width < 1650px ? 4 : 5;
        } else if root.density-setting == 2 {
            root.grid-cols = self.width < 1100px ? 1 : self.width < 1500px ? 2 : 3;
        } else {
            root.grid-cols = self.width < 880px ? (root.mobile-two ? 2 : 1) : self.width < 1250px ? 2 : self.width < 1650px ? 3 : 4;
        }
    }
    changed grid-cols => { root.refresh-masonry(); }
    changed dark => { Theme.dark = root.dark; }
    changed neo => { Theme.neo = root.neo; }

    callback refresh-masonry();

    toastTimer := Timer {
        interval: 3.4s;
        running: root.toast-visible;
        triggered => { root.toast-visible = false; }
    }

    focus-scope := FocusScope {
        init => { focus-scope.focus(); }
        key-pressed(event) => {
            if event.modifiers.control && event.text == "n" { root.new-note(); return accept; }
            if event.modifiers.control && event.text == "f" {
                if root.has-note { root.editor-find-open = true; return accept; }
                root.search-focus-token = root.search-focus-token + 1;
                return accept;
            }
            if event.modifiers.control && event.text == "z" && root.doodle-open { root.doodle-undo(); return accept; }
            if event.text == "\u{1b}" {
                if root.doodle-open { root.doodle-cancel(); return accept; }
                if root.show-settings { root.show-settings = false; return accept; }
                if root.timestamps-open { root.timestamps-open = false; return accept; }
                if root.show-markdown-guide { root.show-markdown-guide = false; return accept; }
                if root.image-preview-open { root.close-image-preview(); return accept; }
                if root.editor-find-open { root.close-find(); return accept; }
                if root.folder-menu-open { root.folder-menu-open = false; return accept; }
                if root.color-popover-open { root.color-popover-open = false; return accept; }
                if root.composer-color-popover-open { root.composer-color-popover-open = false; return accept; }
                if root.search-text != "" { root.search-changed(""); return accept; }
                if root.compact && root.has-note { root.back-to-list(); return accept; }
                return accept;
            }
            reject
        }

        // ============ LOCKED VAULT ============
        if !root.vault-unlocked:
            UnlockOverlay {
                mode: root.vault-mode;
                password <=> root.vault-password;
                confirm <=> root.vault-confirm;
                error <=> root.vault-error;
                show-password <=> root.vault-show-password;
                unlock => { root.vault-unlock(); }
                create-vault => { root.vault-create-from-unlock(); }
                forgot => { root.vault-forgot(); }
            }

        // ============ APP ============
        if root.vault-unlocked:
            app := Rectangle {
                width: root.width;
                height: root.height;
                clip: true;
                background: Theme.bg;

                VerticalLayout {
                    // ===== TOP BAR =====
                    Rectangle {
                        height: Theme.topbar-height;
                        background: Theme.bg;
                        Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }
                        hamburgerBtn := IconButton {
                            x: 10px; y: 11px; size: 42px;
                            clicked => { root.toggle-sidebar(); }
                            IconMenu { stroke-color: Theme.text-dim; preferred-width: 20px; preferred-height: 20px; }
                        }
                        ghostLogoSlot := Rectangle {
                            x: 64px; y: 17px; width: 30px; height: 30px;
                            VerticalLayout { alignment: center; HorizontalLayout { alignment: center; IconGhost { preferred-width: 26px; preferred-height: 26px; stroke-color: Theme.accent; } } }
                        }
                        wordMark := Text {
                            visible: root.width >= 560px;
                            x: 104px; y: 0px; height: parent.height; vertical-alignment: center;
                            text: "Notes"; font-size: 21px; font-weight: 600; color: Theme.text;
                        }
                        searchWrap := Rectangle {
                            x: 210px; y: 10px; width: 560px; height: 44px;
                            visible: root.width >= 760px;
                            VerticalLayout {
                                alignment: center;
                                search := SearchBar {
                                    text <=> root.search-text;
                                    focus-token <=> root.search-focus-token;
                                    width: 100%;
                                    submitted => { root.search-changed(root.search-text); }
                                    cleared => { root.search-changed(""); }
                                }
                            }
                        }
                        viewToggleBtn := IconButton {
                            x: 786px; y: 11px; size: 42px;
                            clicked => { root.toggle-view-mode(); }
                            if root.list-view: IconLayoutGrid { stroke-color: Theme.text-dim; preferred-width: 20px; preferred-height: 20px; }
                            if !root.list-view: IconList { stroke-color: Theme.text-dim; preferred-width: 20px; preferred-height: 20px; }
                        }
                        newNoteBtn := Rectangle {
                            x: 836px; y: 11px; width: 42px; height: 42px; border-radius: 21px; background: Theme.accent;
                            newTouch := TouchArea { mouse-cursor: pointer; clicked => { root.new-note(); } }
                            VerticalLayout { alignment: center; HorizontalLayout { alignment: center; IconPlus { stroke-color: Theme.on-accent; preferred-width: 22px; preferred-height: 22px; } } }
                        }
                    }

                    if root.vault-mismatch:
                        Rectangle {
                            height: 42px;
                            background: Theme.danger-soft;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 12px;
                                spacing: 10px;
                                VerticalLayout { alignment: center; IconLock { stroke-color: Theme.danger; preferred-width: 17px; preferred-height: 17px; } }
                                Text { text: "Wrong password on this device — your notes can't be decrypted."; font-size: 12px; color: Theme.danger; vertical-alignment: center; horizontal-stretch: 1; }
                                TextButton { label: "Unlock correctly"; clicked => { root.lock-now(); } }
                            }
                        }

                    // ===== MAIN ROW =====
                    HorizontalLayout {
                        vertical-stretch: 1;
                        height: root.height - Theme.topbar-height - 26px;
                        spacing: 0px;

                        // ---- left rail ----
                        Rectangle {
                            width: Theme.rail-width;
                            background: Theme.bg;
                            railScroll := Flickable {
                                width: 100%;
                                height: 100%;
                                content-width: self.width;
                                content-height: railColumn.preferred-height;
                                railColumn := VerticalLayout {
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 1px;
                                RailButton { label: "Notes"; selected: root.active-view == 0 && root.active-folder == "" && root.active-tag == "" && root.layout-style != 4; clicked => { root.layout-selected(0); root.view-selected(0); } IconFileText { stroke-color: (root.active-view == 0 && root.active-folder == "" && root.active-tag == "" && root.layout-style != 4) ? Theme.accent : Theme.text-dim; preferred-width: 22px; preferred-height: 22px; } }
                                RailButton { label: "Pinned"; selected: root.active-view == 1; clicked => { root.layout-selected(0); root.view-selected(1); } IconPin { stroke-color: root.active-view == 1 ? Theme.accent : Theme.text-dim; preferred-width: 21px; preferred-height: 21px; } }
                                RailButton { label: "Favorites"; selected: root.active-view == 2; clicked => { root.layout-selected(0); root.view-selected(2); } IconStar { stroke-color: root.active-view == 2 ? Theme.accent : Theme.text-dim; preferred-width: 21px; preferred-height: 21px; } }
                                RailButton { label: "Archive"; selected: root.active-view == 3; clicked => { root.layout-selected(0); root.view-selected(3); } IconArchive { stroke-color: root.active-view == 3 ? Theme.accent : Theme.text-dim; preferred-width: 20px; preferred-height: 20px; } }
                                RailButton { label: "Trash"; selected: root.active-view == 4; clicked => { root.layout-selected(0); root.view-selected(4); } IconTrash { stroke-color: root.active-view == 4 ? Theme.accent : Theme.text-dim; preferred-width: 20px; preferred-height: 20px; } }
                                RailButton { label: "Vault"; selected: root.layout-style == 2; clicked => { root.layout-selected(2); } IconPanelLeft { stroke-color: root.layout-style == 2 ? Theme.accent : Theme.text-dim; preferred-width: 21px; preferred-height: 21px; } }
                                RailButton { label: "Graph"; selected: root.layout-style == 4; clicked => { root.layout-selected(4); } IconLink2 { stroke-color: root.layout-style == 4 ? Theme.accent : Theme.text-dim; preferred-width: 21px; preferred-height: 21px; } }
                                Rectangle {}
                                Divider { width: 44px; x: 14px; }
                                RailButton { label: Theme.dark ? "Light" : "Dark"; clicked => { root.toggle-theme(); } if Theme.dark: IconSun { stroke-color: Theme.text-dim; preferred-width: 20px; preferred-height: 20px; } if !Theme.dark: IconMoon { stroke-color: Theme.text-dim; preferred-width: 20px; preferred-height: 20px; } }
                                RailButton { label: "Settings"; clicked => { root.show-settings = true; } IconSettings { stroke-color: Theme.text-dim; preferred-width: 20px; preferred-height: 20px; } }
                                }
                            }
                        }

                        // ---- folder sidebar ----
                        if root.sidebar-open:
                            Rectangle {
                                width: Theme.sidebar-width;
                                background: Theme.bg;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        height: 32px;
                                        Text { text: "FOLDERS"; font-size: 11px; font-weight: 700; letter-spacing: 1.1px; color: Theme.text-faint; vertical-alignment: center; horizontal-stretch: 1; }
                                        IconButton { size: 27px; clicked => { root.new-folder(); } IconFolderPlus { stroke-color: Theme.text-dim; preferred-width: 16px; preferred-height: 16px; } }
                                    }
                                    if root.new-folder-open:
                                        folderInputRow := Rectangle {
                                            height: 38px;
                                            border-radius: Theme.r-md;
                                            background: Theme.surface-2;
                                            folderInput := TextInput {
                                                x: 12px; width: parent.width - 48px; height: 100%; single-line: true;
                                                font-size: 13.5px; color: Theme.text; vertical-alignment: center; text <=> root.new-folder-name;
                                                selection-background-color: Theme.accent-soft;
                                                key-pressed(event) => {
                                                    if event.text == "\n" { root.create-folder(self.text); return accept; }
                                                    if event.text == "\u{1b}" { root.cancel-new-folder(); return accept; }
                                                    reject
                                                }
                                            }
                                        }
                                    for folder[fi] in root.folders:
                                        folderRow := SidebarRow {
                                            label: folder.name;
                                            meta: folder.meta;
                                            selected: root.active-folder == folder.id;
                                            show-delete: true;
                                            clicked => { root.folder-selected(folder.id); }
                                            delete => { root.delete-folder(folder.id); }
                                            IconFolder { stroke-color: folderRow.selected ? Theme.accent : Theme.text-dim; preferred-width: 17px; preferred-height: 17px; }
                                        }
                                    Rectangle { height: 14px; }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        height: 32px;
                                        Text { text: "TAGS"; font-size: 11px; font-weight: 700; letter-spacing: 1.1px; color: Theme.text-faint; vertical-alignment: center; }
                                    }
                                    for tag[ti] in root.tags:
                                        tagRow := SidebarRow {
                                            label: "#  " + tag.name;
                                            meta: tag.meta;
                                            selected: root.active-tag == tag.name;
                                            clicked => { root.tag-selected(tag.name); }
                                            IconTag { stroke-color: tagRow.selected ? Theme.accent : Theme.text-dim; preferred-width: 15px; preferred-height: 15px; }
                                        }
                                    Rectangle {}
                                    Divider {}
                                    HorizontalLayout {
                                        padding-left: 10px; padding-right: 10px; padding-top: 8px; padding-bottom: 4px;
                                        Text { text: "Everything is stored locally on this device."; font-size: 11px; color: Theme.text-faint; wrap: word-wrap; }
                                    }
                                }
                            }
                        if root.sidebar-open:
                            Rectangle { width: 1px; background: Theme.border; }

                        // ===== content region =====
                        if root.layout-style != 2 && root.layout-style != 4 && root.compact && !root.has-note:
                                boardPane := Rectangle {
                                    horizontal-stretch: 1;
                                    height: 100%;
                                    background: Theme.bg;
                                    clip: true;
                                    VerticalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        padding-top: 8px;
                                        preferred-height: 1px;
                                        NewNoteComposer { width: 100%; height: 74px; open <=> root.composer-open; title <=> root.composer-title; body <=> root.composer-body; pinned <=> root.composer-pinned; color-index <=> root.composer-color-index; checklist-mode <=> root.composer-checklist-mode; preview-mode <=> root.composer-preview-mode; checklist-items <=> root.composer-checklist-items; preview-styled: root.composer-preview-styled; pending-images <=> root.composer-pending-images; color-popover-open <=> root.composer-color-popover-open; open-requested => { root.composer-open-requested(); } close-requested => { root.composer-close-requested(); } content-changed => { root.composer-content-changed(); } toggle-pin => { root.composer-toggle-pin(); } color-picked(idx) => { root.composer-color-picked(idx); } image-requested => { root.composer-image-requested(); } draw-requested => { root.composer-draw-requested(); } checklist-toggle => { root.composer-checklist-toggle(); } preview-toggle => { root.composer-preview-toggle(); } checklist-add(text) => { root.composer-checklist-add(text); } checklist-toggle-item(line) => { root.composer-checklist-toggle-item(line); } checklist-edit-item(line, text) => { root.composer-checklist-edit-item(line, text); } checklist-remove-item(line) => { root.composer-checklist-remove-item(line); } remove-pending-image(id) => { root.composer-remove-pending-image(id); } }
                                        NoteListPanel { vertical-stretch: 1; height: 340px;
                                            horizontal-stretch: 1;
                                            pinned-notes: root.pinned-notes;
                                            notes: root.notes;
                                            pinned-col-0: root.pinned-col-0; pinned-col-1: root.pinned-col-1; pinned-col-2: root.pinned-col-2; pinned-col-3: root.pinned-col-3; pinned-col-4: root.pinned-col-4;
                                            notes-col-0: root.notes-col-0; notes-col-1: root.notes-col-1; notes-col-2: root.notes-col-2; notes-col-3: root.notes-col-3; notes-col-4: root.notes-col-4;
                                            list-view: root.list-view;
                                            layout-style: root.layout-style;

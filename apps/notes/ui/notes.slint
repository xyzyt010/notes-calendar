                        export-all => { root.export-all-md(); }
                        empty-trash => { root.show-empty-trash = true; }
                        create-vault(pass, confirm) => { root.create-vault(pass, confirm); }
                        change-password(cur, newpass) => { root.change-password(cur, newpass); }
                        reset-password(newpass, confirm, ack) => { root.reset-password(newpass, confirm, ack); }
                        lock-now => { root.lock-now(); }
                    }

                if root.show-markdown-guide:
                    MarkdownGuide { closed => { root.show-markdown-guide = false; } }

                if root.timestamps-open:
                    timestamps := Rectangle {
                        width: 100%; height: 100%; background: Theme.scrim;
                        TouchArea { clicked => { root.timestamps-open = false; } }
                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2 - 40px;
                            width: min(430px, parent.width - 48px);
                            height: min(480px, parent.height - 48px);
                            border-radius: Theme.r-lg;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            VerticalLayout {
                                padding: 22px;
                                spacing: 10px;
                                Text { text: "Note — timestamps"; font-size: 17px; font-weight: 650; color: Theme.text; }
                                HorizontalLayout {
                                    Text { text: "Created"; font-size: 12px; color: Theme.text-faint; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: root.timestamp-created; font-size: 12px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                                }
                                HorizontalLayout {
                                    Text { text: "Last edited"; font-size: 12px; color: Theme.text-faint; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: root.timestamp-edited; font-size: 12px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                Text { text: "ACTIVITY"; font-size: 10.5px; font-weight: 700; letter-spacing: 1px; color: Theme.text-faint; }
                                Flickable {
                                    vertical-stretch: 1;
                                    height: 100%;
                                    content-height: activityList.preferred-height;
                                    activityList := VerticalLayout {
                                        spacing: 6px;
                                        for activity[i] in root.timestamp-activity:
                                            Text { text: "•  " + activity; font-size: 12px; color: Theme.text-dim; }
                                        if root.timestamp-activity.length == 0:
                                            Text { text: "No activity recorded yet."; font-size: 12px; color: Theme.text-faint; }
                                    }
                                }
                                HorizontalLayout { alignment: end; TextButton { label: "Close"; emphasis: true; clicked => { root.timestamps-open = false; } } }
                            }
                        }
                    }

                if root.image-preview-open:
                    lightbox := Rectangle {
                        width: 100%; height: 100%; background: #000000D9;
                        TouchArea { clicked => { root.close-image-preview(); } }
                        IconButton {
                            x: parent.width - 54px; y: 16px; size: 38px;
                            clicked => { root.close-image-preview(); }
                            Text { text: "×"; font-size: 25px; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Image {
                            x: 40px; y: 48px; width: parent.width - 80px; height: parent.height - 140px;
                            source: root.image-preview-image;
                            image-fit: contain;
                        }
                        HorizontalLayout {
                            x: 40px; y: parent.height - 62px; width: parent.width - 80px; height: 30px;
                            Text { text: root.image-preview-name + "  ·  " + root.image-preview-size; font-size: 12px; color: #e8eaed; vertical-alignment: center; horizontal-stretch: 1; }
                            TextButton { label: "Download"; emphasis: true; clicked => { root.image-download-preview(); } }
                        }
                    }

                if root.show-delete-forever:
                    ConfirmDialog {
                        title: "Delete forever?";
                        message: "This note and its attachments will be permanently deleted. This action cannot be undone.";
                        confirm-label: "Delete";
                        danger: true;
                        confirmed => { root.delete-forever-confirmed(); }
                        cancelled => { root.show-delete-forever = false; }
                    }

                if root.show-empty-trash:
                    ConfirmDialog {
                        title: "Empty trash?";
                        message: "All notes in Trash and their attachments will be permanently deleted. This action cannot be undone.";
                        confirm-label: "Empty trash";
                        danger: true;
                        confirmed => { root.empty-trash-confirmed(); }
                        cancelled => { root.show-empty-trash = false; }
                    }

                if root.toast-visible:
                    Toast {
                        width: max(220px, self.preferred-width);
                        x: (app.width - self.width) / 2;
                        y: app.height - 66px;
                        message: root.toast-message;
                    }
            }
    }
}

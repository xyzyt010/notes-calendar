// yellod Notes — main window.
// Webapp parity: top bar → [sidebar | content (list pane + editor / ghost)] → status bar.

import { Theme } from "../../shared-ui/theme.slint";
import { AboutSlint } from "std-widgets.slint";
import {
    IconBrand, IconMenu, IconPlus, IconPin, IconStar, IconArchive, IconTrash, IconLogout, IconEmptyTrash,
    IconSettings, IconMoon, IconSun, IconLayoutGrid, IconList, IconImage, IconPencil, IconDownload,
    IconFileText, IconFolder, IconFolderPlus, IconTag, IconPanelLeft, IconLink2, IconLock,
} from "../../shared-ui/icons.slint";
import {
    SearchBar, IconButton, SidebarRow, RailRow, Divider, ConfirmDialog,
    Toast, NoteData, FolderData, TagData, TextButton, EmptyState,
    NoteImageData, ChecklistItemData, GraphNodeData, GraphLinkData, DoodleStrokeData,
} from "../../shared-ui/components.slint";
import { NoteListPanel } from "note-grid.slint";
import { EditorPane } from "editor.slint";
import { NewNoteComposer } from "composer.slint";
import { VaultView } from "vault-view.slint";
import { GraphView } from "graph-view.slint";
import { UnlockOverlay } from "unlock.slint";
import { SettingsView } from "settings.slint";
import { MarkdownGuide } from "markdown-guide.slint";
import { DoodleOverlay } from "doodle.slint";

// Drawer row set shared by the desktop rail and the compact overlay drawer.
// Rows are the expanded (labels-first) set; the desktop rail adds icon-only
// RailRows around this same content.
component DrawerMenu inherits VerticalLayout {
    in-out property <int> active-view: 0;
    in-out property <string> active-folder: "";
    in-out property <string> active-tag: "";
    in-out property <int> layout-style: 0;
    in-out property <bool> dark: true;
    in-out property <int> live-count: 0;
    in-out property <int> pinned-count: 0;
    in-out property <int> archive-count: 0;
    in-out property <int> trash-count: 0;
    in-out property <[FolderData]> folders: [];
    in-out property <[TagData]> tags: [];
    in-out property <bool> new-folder-open: false;
    in-out property <string> new-folder-name: "";

    callback view-selected(int);
    callback layout-selected(int);
    callback toggle-theme();
    callback new-folder();
    callback create-folder(string);
    callback cancel-new-folder();
    callback folder-selected(string);
    callback delete-folder(string);
    callback tag-selected(string);
    callback empty-trash-requested();
    callback settings-requested();

    spacing: 2px;
    Text { text: "Notes"; font-size: 13px; color: Theme.text-dim; horizontal-stretch: 1; height: 28px; vertical-alignment: center; wrap: no-wrap; overflow: elide; }
    SidebarRow { labels: true; selected: root.active-view == 0 && root.active-folder == "" && root.active-tag == "" && root.layout-style != 4 && root.layout-style != 2; label: "Notes"; meta: root.live-count == 0 ? "" : root.live-count + ""; clicked => { root.view-selected(0); } IconBrand { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
    SidebarRow { labels: true; selected: root.active-view == 1; label: "Pinned"; meta: root.pinned-count == 0 ? "" : root.pinned-count + ""; clicked => { root.view-selected(1); } IconPin { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
    SidebarRow { labels: true; selected: root.active-view == 3; label: "Archived"; meta: root.archive-count == 0 ? "" : root.archive-count + ""; clicked => { root.view-selected(3); } IconArchive { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
    SidebarRow { labels: true; selected: root.active-view == 4; label: "Trash"; meta: root.trash-count == 0 ? "" : root.trash-count + ""; clicked => { root.view-selected(4); } IconTrash { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
    Rectangle { height: 8px; }
    if root.active-view == 4:
        SidebarRow { labels: true; label: "Empty trash"; meta: ""; clicked => { root.empty-trash-requested(); } IconEmptyTrash { stroke-color: Theme.danger; preferred-width: 20px; preferred-height: 20px; } }
    Rectangle { height: 8px; }
    SidebarRow { labels: true; label: "Settings"; meta: ""; clicked => { root.settings-requested(); } IconSettings { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
    Divider {}
    SidebarRow { labels: true; selected: root.active-view == 2; label: "Favorites"; meta: ""; clicked => { root.view-selected(2); } IconStar { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
    SidebarRow { labels: true; selected: root.layout-style == 2; label: "Vault"; meta: ""; clicked => { root.layout-selected(2); } IconPanelLeft { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
    SidebarRow { labels: true; selected: root.layout-style == 4; label: "Graph"; meta: ""; clicked => { root.layout-selected(4); } IconLink2 { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
    SidebarRow { labels: true; label: root.dark ? "Light" : "Dark"; meta: ""; clicked => { root.toggle-theme(); } IconMoon { stroke-color: Theme.text-dim; preferred-width: 20px; preferred-height: 20px; } }
    Rectangle { height: 14px; }
    HorizontalLayout {
        padding-left: 8px;
        height: 30px;
        Text { text: "FOLDERS"; font-size: 12px; font-weight: 700; letter-spacing: 1.1px; color: Theme.text-faint; vertical-alignment: center; horizontal-stretch: 1; }
        IconButton { size: 28px; clicked => { root.new-folder(); } IconFolderPlus { stroke-color: Theme.icon; preferred-width: 18px; preferred-height: 18px; } }
    }
    if root.new-folder-open:
        Rectangle {
            height: 38px;
            border-radius: Theme.r-md;
            background: Theme.surface-2;
            TextInput {
                x: 12px; width: parent.width - 24px; height: 100%; single-line: true;
                font-size: 13.5px; color: Theme.text; vertical-alignment: center; text <=> root.new-folder-name;
                selection-background-color: Theme.accent-soft;
                key-pressed(event) => {
                    if event.text == "\n" { root.create-folder(self.text); return accept; }
                    if event.text == "\u{1b}" { root.cancel-new-folder(); return accept; }
                    reject
                }
            }
        }
    for folder[fi] in root.folders:
        SidebarRow {
            labels: true;
            label: folder.name;
            meta: folder.meta;
            selected: root.active-folder == folder.id;
            show-delete: true;
            clicked => { root.folder-selected(folder.id); }
            delete => { root.delete-folder(folder.id); }
            IconFolder { stroke-color: Theme.icon; preferred-width: 19px; preferred-height: 19px; }
        }
    Rectangle { height: 14px; }
    HorizontalLayout {
        padding-left: 8px;
        height: 30px;
        Text { text: "TAGS"; font-size: 12px; font-weight: 700; letter-spacing: 1.1px; color: Theme.text-faint; vertical-alignment: center; }
    }
    for tag[ti] in root.tags:
        SidebarRow {
            labels: true;
            label: "#  " + tag.name;
            meta: tag.meta;
            selected: root.active-tag == tag.name;
            clicked => { root.tag-selected(tag.name); }
            IconTag { stroke-color: Theme.icon; preferred-width: 17px; preferred-height: 17px; }
        }
    Divider {}
    Rectangle { height: 8px; }
    SidebarRow { labels: true; label: "Layout: " + (root.layout-style == 1 ? "Notion" : root.layout-style == 2 ? "Obsidian" : root.layout-style == 3 ? "Neomorph" : root.layout-style == 4 ? "3D graph" : "Keep"); meta: ""; clicked => { root.layout-selected(root.layout-style == 4 ? 0 : root.layout-style + 1); } IconLayoutGrid { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
}

export component MainWindow inherits Window {
    title: "Notes";
    icon: @image-url("../../../assets/app-icon.png");
    default-font-family: "Inter";
    background: Theme.bg;
    preferred-width: 1100px;
    preferred-height: 680px;
    min-width: 640px;
    min-height: 420px;

    // ---------- Rust-facing state ----------
    in-out property <bool> dark: true;
    in-out property <bool> neo: false;
    in-out property <[NoteData]> pinned-notes: [];
    in-out property <[NoteData]> notes: [];
    in-out property <[FolderData]> folders: [];
    in-out property <[TagData]> tags: [];
    in-out property <string> selected-id: "";
    in-out property <bool> dragging: false;
    in-out property <string> drag-id: "";
    in-out property <NoteData> drag-card;
    in-out property <length> drag-abs-x: 0px;
    in-out property <length> drag-abs-y: 0px;
    in-out property <length> grab-dx: 0px;
    in-out property <length> grab-dy: 0px;
    in-out property <int> active-view: 0;
    in-out property <string> active-folder: "";
    in-out property <string> active-tag: "";
    in-out property <string> search-text: "";
    in-out property <int> search-focus-token: 0;
    in-out property <bool> list-view: false;
    in-out property <int> layout-style: 0;   // 0 Keep · 1 Notion · 2 Obsidian · 3 Neomorph · 4 Graph
    in-out property <int> density-setting: 1;
    in-out property <bool> mobile-two: true;
    in-out property <int> sort-setting: 0;
    in-out property <bool> pinned-first: true;
    in-out property <bool> md-cards: false;
    in-out property <bool> show-dates: false;
    in-out property <int> card-clamp: 0;
    in-out property <int> note-count: 0;
    in-out property <int> drawer-live-count: 0;
    in-out property <int> drawer-pinned-count: 0;
    in-out property <int> drawer-archive-count: 0;
    in-out property <int> drawer-trash-count: 0;
    in-out property <int> grid-cols: 4;
    in-out property <bool> rail-hover: false;
    in-out property <bool> sidebar-open: false;
    in-out property <bool> compact: false;
    in-out property <bool> pinned-section: false;
    in-out property <string> selected-folder-of-editor: "";
    in-out property <bool> new-folder-open: false;
    in-out property <string> new-folder-name: "";
    in-out property <[length]> board-lefts: [];
    in-out property <[length]> board-tops: [];
    in-out property <int> board-cols: 1;
    in-out property <length> board-pin-w: 240px;
    in-out property <length> board-notes-w: 240px;
    in-out property <length> board-pin-block-h: 0px;
    in-out property <string> app-version: "1.1.0";
    in-out property <length> canvas-height: 800px;
    in-out property <int> drag-target: -1;
    in-out property <length> drag-target-x: 0px;
    in-out property <length> drag-target-y: 0px;
    in-out property <length> drag-target-h: 170px;

    // Editor state
    in-out property <bool> has-note: false;
    // modal visibility that lags has-note by one fade-out (keeps the exit animation)
    in-out property <bool> modal-showing: false;
    in-out property <string> editor-title: "";
    in-out property <string> editor-body: "";
    in-out property <int> editor-body-cursor-position: 0;
    in-out property <length> editor-body-height: 110px;
    in-out property <[string]> editor-tags: [];
    in-out property <bool> editor-pinned: false;
    in-out property <bool> editor-favorite: false;
    in-out property <int> word-count: 0;
    in-out property <int> save-state: 0;
    in-out property <string> edited-label: "";
    in-out property <bool> folder-menu-open: false;
    in-out property <bool> color-popover-open: false;
    in-out property <bool> editor-more-popover-open: false;
    in-out property <int> current-note-color-index: 0;
    in-out property <[NoteImageData]> current-images: [];
    in-out property <int> current-image-count: 0;
    in-out property <[ChecklistItemData]> checklist-items: [];
    in-out property <[string]> editor-links: [];
    in property <styled-text> editor-markdown;
    in-out property <int> editor-mode: 0;
    in-out property <bool> editor-checklist-mode: false;
    in-out property <bool> editor-find-open: false;
    in-out property <string> editor-find-query: "";
    in-out property <int> editor-find-count: 0;
    in-out property <int> editor-find-index: 0;
    in-out property <[string]> editor-suggestions: [];
    in-out property <bool> editor-suggestions-visible: false;

    in-out property <int> find-selection-offset: 0;
    in-out property <int> find-selection-length: 0;
    in-out property <int> find-selection-token: 0;
    in-out property <int> editor-find-item: -1;

    // Composer state
    in-out property <bool> composer-open: false;
    in-out property <string> composer-title: "";
    in-out property <string> composer-body: "";
    in-out property <bool> composer-pinned: false;
    in-out property <int> composer-color-index: 0;
    in-out property <bool> composer-checklist-mode: false;
    in-out property <bool> composer-preview-mode: false;
    in-out property <[ChecklistItemData]> composer-checklist-items: [];
    in property <styled-text> composer-preview-styled;
    in-out property <[NoteImageData]> composer-pending-images: [];
    in-out property <bool> composer-color-popover-open: false;

    // Vault / unlock state
    in-out property <bool> vault-enabled: false;
    in-out property <bool> vault-unlocked: true;
    in-out property <bool> vault-mismatch: false;
    in-out property <int> vault-mode: 1;
    in-out property <string> vault-password: "";
    in-out property <string> vault-confirm: "";
    in-out property <string> vault-error: "";
    in-out property <bool> vault-show-password: false;

    // Vault view state
    in-out property <string> vault-filter: "";
    in-out property <[NoteData]> vault-notes: [];
    in-out property <string> vault-selected-id: "";
    in-out property <bool> vault-has-note: false;
    in-out property <string> vault-title: "";
    in-out property <string> vault-meta: "";
    in property <styled-text> vault-markdown;
    in-out property <string> vault-source: "";
    in-out property <bool> vault-source-mode: false;
    in-out property <[string]> vault-links-out: [];
    in-out property <[string]> vault-backlinks: [];
    in-out property <bool> vault-pinned: false;

    // Graph state
    in-out property <[GraphNodeData]> graph-nodes: [];
    in-out property <[GraphLinkData]> graph-links: [];
    in-out property <bool> graph-has-selection: false;
    in-out property <string> graph-selected-id: "";
    in-out property <string> graph-selected-title: "";
    in-out property <string> graph-selected-meta: "";
    in property <styled-text> graph-selected-markdown;
    in-out property <[string]> graph-selected-links: [];

    // Doodle state
    in-out property <bool> doodle-open: false;
    in-out property <[DoodleStrokeData]> doodle-strokes: [];
    in-out property <color> doodle-pen-color: #5dd8ff;
    in-out property <length> doodle-pen-size: 5px;

    // Settings / overlays
    in-out property <bool> show-settings: false;
    in-out property <bool> show-markdown-guide: false;
    in-out property <bool> timestamps-open: false;
    in-out property <string> timestamps-title: "Note";
    in-out property <string> timestamp-created: "";
    in-out property <string> timestamp-edited: "";
    in-out property <[string]> timestamp-activity: [];
    in-out property <bool> show-delete-forever: false;
    in-out property <bool> show-empty-trash: false;
    in-out property <bool> image-preview-open: false;
    in-out property <string> image-preview-id: "";
    in-out property <image> image-preview-image;
    in-out property <string> image-preview-name: "";
    in-out property <string> image-preview-size: "";
    in-out property <string> settings-security-error: "";
    in-out property <int> settings-security-mode: 0;
    in-out property <int> settings-password-strength: 0;
    in-out property <string> settings-new-password: "";
    in-out property <string> settings-confirm-password: "";
    in-out property <string> settings-current-password: "";
    in-out property <bool> settings-reset-acknowledged: false;
    in-out property <string> settings-stats: "";
    in-out property <string> toast-message: "";
    in-out property <bool> toast-visible: false;

    // ---------- Rust-facing actions ----------
    callback new-note();
    callback search-changed(string);
    callback view-selected(int);
    callback folder-selected(string);
    callback new-folder();
    callback create-folder(string);
    callback cancel-new-folder();
    callback delete-folder(string);
    callback tag-selected(string);
    callback note-activated(string);
    callback note-double-clicked(string);
    callback pin-toggled(string);
    callback card-archive(string);
    callback card-trash(string);
    callback card-restore(string);
    callback card-delete-forever(string);
    callback card-color-picked(string, int);
    callback card-export(string);
    callback card-timestamps(string);
    callback card-checklist-toggle(string, int);
    callback drag-reorder(string, int);
    callback drag-finish();
    callback board-metrics(length);
    callback drag-move-rust(length, length);
    callback archive-editor();
    callback trash-editor();
    callback restore-editor();
    callback delete-forever-confirmed();
    callback empty-trash-confirmed();
    callback copy-editor();
    callback export-editor();
    callback export-note-txt();
    callback format-tool(string);
    callback editor-content-changed();
    callback tag-added(string);
    callback tag-removed(string);
    callback assign-folder(string);
    callback color-picked(int);
    callback toggle-sidebar();
    callback toggle-view-mode();
    callback toggle-theme();
    callback toggle-pin-editor();
    callback toggle-favorite-editor();
    callback back-to-list();
    callback layout-selected(int);
    callback vault-unlock();
    callback vault-create-from-unlock();
    callback vault-forgot();
    callback lock-now();
    callback create-vault(string, string);
    callback password-edited();
    callback change-password(string, string);
    callback reset-password(string, string, bool);
    callback composer-open-requested();
    callback composer-close-requested();
    callback composer-content-changed();
    callback composer-toggle-pin();
    callback composer-color-picked(int);
    callback composer-image-requested();
    callback composer-draw-requested();
    callback composer-checklist-toggle();
    callback composer-preview-toggle();
    callback composer-checklist-add(string);
    callback composer-checklist-toggle-item(int);
    callback composer-checklist-edit-item(int, string);
    callback composer-checklist-remove-item(int);
    callback composer-remove-pending-image(string);
    callback attach-images();
    callback draw-editor();
    callback image-preview(string);
    callback image-delete(string);
    callback image-download(string);
    callback image-download-preview();
    callback close-image-preview();
    callback checklist-toggle();
    callback checklist-add(string);
    callback checklist-toggle-item(int);
    callback checklist-edit-item(int, string);
    callback checklist-remove-item(int);
    callback link-clicked(string);
    callback find-changed();
    callback open-link();
    callback find-next();
    callback find-previous();
    callback close-find();
    callback suggestion-picked(string);
    callback vault-filter-changed(string);
    callback vault-note-selected(string);
    callback vault-new-note();
    callback vault-pin-toggled();
    callback vault-edit-source();
    callback vault-source-edited();
    callback vault-open();
    callback vault-title-edited(string);
    callback graph-pointer-down(length, length, bool);
    callback graph-pointer-move(length, length, bool);
    callback graph-pointer-up(length, length, bool);
    callback graph-wheel(length, bool);
    callback graph-tick();
    callback graph-relabel();
    callback graph-close-selection();
    callback graph-open-note();
    callback graph-unlink-all();
    callback doodle-draw-down(length, length, bool);
    callback doodle-draw-move(length, length, bool);
    callback doodle-draw-up(length, length);
    callback doodle-undo();
    callback doodle-clear();
    callback doodle-cancel();
    callback doodle-save();
    callback show-timestamps();
    callback markdown-guide();
    callback import-md();
    callback export-all-md();
    callback settings-density-selected(int);
    callback settings-sort-selected(int);
    callback settings-toggle-mobile-two();
    callback settings-toggle-pinned-first();
    callback settings-toggle-md-cards();
    callback settings-toggle-show-dates();
    callback settings-clamp-selected(int);

    changed width => {
        root.compact = self.width <= 720px;
        if root.density-setting == 0 {
            root.grid-cols = self.width <= 720px ? (root.mobile-two ? 2 : 1) : self.width < 1250px ? 3 : self.width < 1650px ? 4 : 5;
        } else if root.density-setting == 2 {
            root.grid-cols = self.width <= 720px ? (root.mobile-two ? 2 : 1) : self.width < 1100px ? 1 : self.width < 1500px ? 2 : 3;
        } else {
            root.grid-cols = self.width <= 720px ? (root.mobile-two ? 2 : 1) : self.width < 1250px ? 3 : self.width < 1650px ? 4 : 5;
        }
    }
    changed density-setting => {
        if root.density-setting == 0 {
            root.grid-cols = self.width <= 720px ? (root.mobile-two ? 2 : 1) : self.width < 1250px ? 3 : self.width < 1650px ? 4 : 5;
        } else if root.density-setting == 2 {
            root.grid-cols = self.width <= 720px ? (root.mobile-two ? 2 : 1) : self.width < 1100px ? 1 : self.width < 1500px ? 2 : 3;
        } else {
            root.grid-cols = self.width <= 720px ? (root.mobile-two ? 2 : 1) : self.width < 1250px ? 3 : self.width < 1650px ? 4 : 5;
        }
    }
    changed mobile-two => {
        if root.density-setting == 0 {
            root.grid-cols = self.width <= 720px ? (root.mobile-two ? 2 : 1) : self.width < 1250px ? 3 : self.width < 1650px ? 4 : 5;
        } else if root.density-setting == 2 {
            root.grid-cols = self.width <= 720px ? (root.mobile-two ? 2 : 1) : self.width < 1100px ? 1 : self.width < 1500px ? 2 : 3;
        } else {
            root.grid-cols = self.width <= 720px ? (root.mobile-two ? 2 : 1) : self.width < 1250px ? 3 : self.width < 1650px ? 4 : 5;
        }
    }
    changed grid-cols => { root.refresh-masonry(); }
    changed dark => { Theme.dark = root.dark; }
    changed neo => { Theme.neo = root.neo; }
    changed has-note => {
        if root.has-note && !root.compact { root.modal-showing = true; }
    }

    modalHideTimer := Timer {
        interval: 210ms;
        running: !root.has-note && root.modal-showing;
        triggered => { root.modal-showing = false; }
    }

    callback refresh-masonry();

    // Rail hover intent (web keep-app.js: pointerenter 130ms open,
    // pointerleave 340ms close, unless pinned via sidebar-open).
    in-out property <bool> rail-inside: false;
    railOpenTimer := Timer {
        interval: 130ms;
        triggered => { if root.rail-inside { root.rail-hover = true; } }
    }
    railCloseTimer := Timer {
        interval: 340ms;
        triggered => { if !root.rail-inside { root.rail-hover = false; } }
    }

    toastTimer := Timer {
        interval: 2.6s;
        running: root.toast-visible;
        triggered => { root.toast-visible = false; }
    }

    graphTimer := Timer {
        interval: 33ms;
        running: root.layout-style == 4 && root.vault-unlocked;
        triggered => { root.graph-tick(); }
    }

    focus-scope := FocusScope {
        init => { focus-scope.focus(); }
        key-pressed(event) => {
            if event.modifiers.control && event.text == "n" { root.new-note(); return accept; }
            if event.modifiers.control && event.text == "k" { root.search-focus-token = root.search-focus-token + 1; return accept; }
            if event.modifiers.control && event.text == "f" {
                if root.has-note { root.editor-find-open = true; return accept; }
                root.search-focus-token = root.search-focus-token + 1;
                return accept;
            }
            if event.modifiers.control && event.text == "z" && root.doodle-open { root.doodle-undo(); return accept; }
            if event.text == "\u{1b}" {
                if root.doodle-open { root.doodle-cancel(); return accept; }
                if root.image-preview-open { root.close-image-preview(); return accept; }
                if root.timestamps-open { root.timestamps-open = false; return accept; }
                if root.show-markdown-guide { root.show-markdown-guide = false; return accept; }
                if root.editor-find-open { root.close-find(); return accept; }
                if root.folder-menu-open { root.folder-menu-open = false; return accept; }
                if root.color-popover-open { root.color-popover-open = false; return accept; }
                if root.editor-more-popover-open { root.editor-more-popover-open = false; return accept; }
                if root.composer-color-popover-open { root.composer-color-popover-open = false; return accept; }
                if root.has-note && !root.compact { root.back-to-list(); return accept; }
                if root.show-settings { root.show-settings = false; return accept; }
                if root.search-text != "" { root.search-changed(""); return accept; }
                if root.compact && root.has-note { root.back-to-list(); return accept; }
                return accept;
            }
            reject
        }

        // ============ LOCKED VAULT ============
        if !root.vault-unlocked:
            UnlockOverlay {
                mode: root.vault-mode;
                password <=> root.vault-password;
                confirm <=> root.vault-confirm;
                error <=> root.vault-error;
                show-password <=> root.vault-show-password;
                unlock => { root.vault-unlock(); }
                create-vault => { root.vault-create-from-unlock(); }
                forgot => { root.vault-forgot(); }
            }

        // ============ APP ============
        if root.vault-unlocked:
            app := Rectangle {
                width: 100%;
                height: 100%;
                background: Theme.bg;

                VerticalLayout {
                    // ===== TOP BAR (webapp parity: hamburger · logo · search · actions) =====
                    Rectangle {
                        height: root.compact ? 56px : Theme.topbar-height;
                        background: Theme.surface;
                        topbarLayout := HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 16px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 6px;
                            hamburgerBtn := IconButton {
                                size: 44px;
                                clicked => { root.toggle-sidebar(); }
                                IconMenu { stroke-color: Theme.icon; preferred-width: 22px; preferred-height: 22px; }
                            }
                            brand := HorizontalLayout {
                                visible: root.width > 720px;
                                spacing: 10px;
                                padding-left: 4px;
                                padding-right: 10px;
                                VerticalLayout { alignment: center; IconBrand { preferred-width: 24px; preferred-height: 24px; stroke-color: Theme.text-dim; } }
                                Text {
                                    text: root.active-view == 0 ? (root.active-folder != "" ? "Folder" : (root.active-tag != "" ? "# " + root.active-tag : "Notes")) : root.active-view == 1 ? "Pinned" : root.active-view == 2 ? "Favorites" : root.active-view == 3 ? "Archived" : "Trash";
                                    font-size: 22px;
                                    font-weight: 400;
                                    color: Theme.text-dim;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            searchWrap := Rectangle {
                                visible: !root.show-settings;
                                width: min(720px, parent.width - 240px);
                                height: root.compact ? 44px : 52px;
                                SearchBar {
                                    width: 100%;
                                    placeholder: root.active-view == 1 ? "Search pinned" : root.active-view == 3 ? "Search archived" : root.active-view == 4 ? "Search trash" : "Search your notes";
                                    text <=> root.search-text;
                                    focus-token <=> root.search-focus-token;
                                    submitted => { root.search-changed(root.search-text); }
                                    cleared => { root.search-changed(""); }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            newNoteBtn := IconButton {
                                size: 44px;
                                clicked => { root.new-note(); }
                                IconPlus { stroke-color: Theme.icon; preferred-width: 22px; preferred-height: 22px; }
                            }
                            // Webapp topbar right: [+] then sign-out (native maps it to
                            // locking the vault -> unlock screen, like the web's logout).
                            IconButton {
                                size: 44px;
                                clicked => { root.lock-now(); }
                                IconLogout { stroke-color: Theme.icon; preferred-width: 22px; preferred-height: 22px; }
                            }
                            // webapp parity: topbar right holds only the New note (+) action;
                            // Settings + layout cycle live in the rail (see sidebar below).
                        }
                    }

                    if root.vault-mismatch:
                        Rectangle {
                            height: 42px;
                            background: root.dark ? #5C2B29 : #FCE8E6;
                            border-width: 1px;
                            border-color: root.dark ? #8A4A47 : #F28B82;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 12px;
                                spacing: 10px;
                                VerticalLayout { alignment: center; IconLock { stroke-color: root.dark ? #FCD9D9 : #A50E0E; preferred-width: 19px; preferred-height: 19px; } }
                                Text { text: "Wrong password on this device — your notes can't be decrypted. Sign out and sign in again with the correct password."; font-size: 13px; color: root.dark ? #FCD9D9 : #A50E0E; vertical-alignment: center; horizontal-stretch: 1; }
                                TextButton { label: "Unlock correctly"; clicked => { root.lock-now(); } }
                            }
                        }

                    // ===== MAIN ROW (webapp parity: sidebar | content) =====
                    mainRow := HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 0px;

                        // ---- icon rail (webapp parity): 64px icons, expands to 280px on hover/pin ----
                        if !root.compact:
                            sidebar := Rectangle {
                                width: root.sidebar-open || root.rail-hover ? 280px : 64px;
                                height: root.height - 64px;
                                vertical-stretch: 1;
                                animate width { duration: 180ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                                background: Theme.drawer-bg;
                                railTa := TouchArea {
                                    changed has-hover => {
                                        root.rail-inside = self.has-hover;
                                        if self.has-hover { railOpenTimer.restart(); } else { railCloseTimer.restart(); }
                                    }
                                }
                                VerticalLayout {
                                    padding-left: root.sidebar-open || root.rail-hover ? 13px : 10px;
                                    padding-right: root.sidebar-open || root.rail-hover ? 14px : 10px;
                                    padding-top: root.sidebar-open || root.rail-hover ? 12px : 6px;
                                    padding-bottom: 10px;
                                    spacing: 2px;

                                    // drawer head (web shows the signed-in user; local app shows product name)
                                    if root.sidebar-open || root.rail-hover:
                                        Text { text: "Notes"; font-size: 13px; color: Theme.text-dim; horizontal-stretch: 1; height: 28px; vertical-alignment: center; wrap: no-wrap; overflow: elide; }

                                    sideScroll := Flickable {
                                        vertical-stretch: 1;
                                        content-width: self.width;
                                        content-height: sideColumn.preferred-height;

                                        sideColumn := VerticalLayout {
                                            spacing: 2px;
                                            if root.sidebar-open || root.rail-hover:
                                                SidebarRow { labels: true; selected: root.active-view == 0 && root.active-folder == "" && root.active-tag == "" && root.layout-style != 4 && root.layout-style != 2; label: "Notes"; meta: root.drawer-live-count == 0 ? "" : root.drawer-live-count + ""; clicked => { root.view-selected(0); } IconBrand { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
                                            if !(root.sidebar-open || root.rail-hover):
                                                RailRow { selected: root.active-view == 0 && root.active-folder == "" && root.active-tag == "" && root.layout-style != 4 && root.layout-style != 2; clicked => { root.view-selected(0); } IconBrand { stroke-color: Theme.icon; preferred-width: 22px; preferred-height: 22px; } }
                                            if root.sidebar-open || root.rail-hover:
                                                SidebarRow { labels: true; selected: root.active-view == 1; label: "Pinned"; meta: root.drawer-pinned-count == 0 ? "" : root.drawer-pinned-count + ""; clicked => { root.view-selected(1); } IconPin { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
                                            if !(root.sidebar-open || root.rail-hover):
                                                RailRow { selected: root.active-view == 1; clicked => { root.view-selected(1); } IconPin { stroke-color: Theme.icon; preferred-width: 22px; preferred-height: 22px; } }
                                            if root.sidebar-open || root.rail-hover:
                                                SidebarRow { labels: true; selected: root.active-view == 3; label: "Archived"; meta: root.drawer-archive-count == 0 ? "" : root.drawer-archive-count + ""; clicked => { root.view-selected(3); } IconArchive { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
                                            if !(root.sidebar-open || root.rail-hover):
                                                RailRow { selected: root.active-view == 3; clicked => { root.view-selected(3); } IconArchive { stroke-color: Theme.icon; preferred-width: 22px; preferred-height: 22px; } }
                                            if root.sidebar-open || root.rail-hover:
                                                SidebarRow { labels: true; selected: root.active-view == 4; label: "Trash"; meta: root.drawer-trash-count == 0 ? "" : root.drawer-trash-count + ""; clicked => { root.view-selected(4); } IconTrash { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
                                            if !(root.sidebar-open || root.rail-hover):
                                                RailRow { selected: root.active-view == 4; clicked => { root.view-selected(4); } IconTrash { stroke-color: Theme.icon; preferred-width: 22px; preferred-height: 22px; } }
                                            // web .drawer-sep spacing
                                            Rectangle { height: 8px; }
                                            if root.active-view == 4:
                                                trashWrap := VerticalLayout {
                                                    spacing: 2px;
                                                    if root.sidebar-open || root.rail-hover:
                                                        SidebarRow { labels: true; label: "Empty trash"; meta: ""; clicked => { root.show-empty-trash = true; } IconEmptyTrash { stroke-color: Theme.danger; preferred-width: 20px; preferred-height: 20px; } }
                                                    if !(root.sidebar-open || root.rail-hover):
                                                        RailRow { danger: true; clicked => { root.show-empty-trash = true; } IconEmptyTrash { stroke-color: Theme.danger; preferred-width: 22px; preferred-height: 22px; } }
                                                }
                                            Rectangle { height: 8px; }
                                            if root.sidebar-open || root.rail-hover:
                                                SidebarRow { labels: true; label: "Settings"; meta: ""; clicked => { root.show-settings = true; } IconSettings { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
                                            if !(root.sidebar-open || root.rail-hover):
                                                RailRow { clicked => { root.show-settings = true; } IconSettings { stroke-color: Theme.icon; preferred-width: 22px; preferred-height: 22px; } }
                                            // ---- extras below the web drawer items (expanded only) ----
                                            if root.sidebar-open || root.rail-hover:
                                                extras := VerticalLayout {
                                                    spacing: 2px;
                                                    Divider {}
                                                    SidebarRow { labels: true; selected: root.active-view == 2; label: "Favorites"; meta: ""; clicked => { root.view-selected(2); } IconStar { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
                                                    SidebarRow { labels: true; selected: root.layout-style == 2; label: "Vault"; meta: ""; clicked => { root.layout-selected(2); } IconPanelLeft { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
                                                    SidebarRow { labels: true; selected: root.layout-style == 4; label: "Graph"; meta: ""; clicked => { root.layout-selected(4); } IconLink2 { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
                                                    SidebarRow { labels: true; label: Theme.dark ? "Light" : "Dark"; meta: ""; clicked => { root.toggle-theme(); } IconMoon { stroke-color: Theme.text-dim; preferred-width: 20px; preferred-height: 20px; } }
                                                    Rectangle { height: 14px; }
                                                    HorizontalLayout {
                                                        padding-left: 8px;
                                                        height: 30px;
                                                        Text { text: "FOLDERS"; font-size: 12px; font-weight: 700; letter-spacing: 1.1px; color: Theme.text-faint; vertical-alignment: center; horizontal-stretch: 1; }
                                                        IconButton { size: 28px; clicked => { root.new-folder(); } IconFolderPlus { stroke-color: Theme.icon; preferred-width: 18px; preferred-height: 18px; } }
                                                    }
                                                    if root.new-folder-open:
                                                        folderInputRow := Rectangle {
                                                            height: 38px;
                                                            border-radius: Theme.r-md;
                                                            background: Theme.surface-2;
                                                            folderInput := TextInput {
                                                                x: 12px; width: parent.width - 24px; height: 100%; single-line: true;
                                                                font-size: 13.5px; color: Theme.text; vertical-alignment: center; text <=> root.new-folder-name;
                                                                selection-background-color: Theme.accent-soft;
                                                                key-pressed(event) => {
                                                                    if event.text == "\n" { root.create-folder(self.text); return accept; }
                                                                    if event.text == "\u{1b}" { root.cancel-new-folder(); return accept; }
                                                                    reject
                                                                }
                                                            }
                                                        }
                                                    for folder[fi] in root.folders:
                                                        folderRow := SidebarRow {
                                                            labels: true;
                                                            label: folder.name;
                                                            meta: folder.meta;
                                                            selected: root.active-folder == folder.id;
                                                            show-delete: true;
                                                            clicked => { root.folder-selected(folder.id); }
                                                            delete => { root.delete-folder(folder.id); }
                                                            IconFolder { stroke-color: Theme.icon; preferred-width: 19px; preferred-height: 19px; }
                                                        }
                                                    Rectangle { height: 14px; }
                                                    HorizontalLayout {
                                                        padding-left: 8px;
                                                        height: 30px;
                                                        Text { text: "TAGS"; font-size: 12px; font-weight: 700; letter-spacing: 1.1px; color: Theme.text-faint; vertical-alignment: center; }
                                                    }
                                                    for tag[ti] in root.tags:
                                                        tagRow := SidebarRow {
                                                            labels: true;
                                                            label: "#  " + tag.name;
                                                            meta: tag.meta;
                                                            selected: root.active-tag == tag.name;
                                                            clicked => { root.tag-selected(tag.name); }
                                                            IconTag { stroke-color: Theme.icon; preferred-width: 17px; preferred-height: 17px; }
                                                        }
                                                }
                                        }
                                    }
                                    Divider {}
                                    Rectangle { height: 8px; }
                                    if root.sidebar-open || root.rail-hover:
                                        SidebarRow { labels: true; label: "Layout: " + (root.layout-style == 1 ? "Notion" : root.layout-style == 2 ? "Obsidian" : root.layout-style == 3 ? "Neomorph" : root.layout-style == 4 ? "3D graph" : "Keep"); meta: ""; clicked => { root.layout-selected(root.layout-style == 4 ? 0 : root.layout-style + 1); } IconLayoutGrid { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; } }
                                    if !(root.sidebar-open || root.rail-hover):
                                        RailRow { clicked => { root.layout-selected(root.layout-style == 4 ? 0 : root.layout-style + 1); } IconLayoutGrid { stroke-color: Theme.icon; preferred-width: 22px; preferred-height: 22px; } }
                                }
                                Rectangle { x: parent.width - 1px; width: 1px; height: 100%; background: Theme.divider; visible: root.sidebar-open || root.rail-hover; }
                            }

                        // ---- content region ----
                        contentRegion := Rectangle {
                            horizontal-stretch: 1;
                            height: root.height - 64px;
                            vertical-stretch: 1;
                            background: Theme.bg;
                            clip: true;

                            // compact (phone): board or full-screen editor
                            if root.layout-style != 2 && root.layout-style != 4 && root.compact && !root.has-note:
                                boardPane := Rectangle {
                                    width: 100%;
                                    height: root.height - 64px;
                                    background: Theme.bg;
                                    clip: true;
                                    VerticalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        padding-top: 8px;
                                        NoteListPanel { vertical-stretch: 1;
                                            horizontal-stretch: 1;
                                            pinned-notes: root.pinned-notes;
                                            notes: root.notes;
                                            list-view: root.list-view;
                                            layout-style: root.layout-style;
                                            density: root.density-setting;
                                            preview-lines: root.card-clamp;
                                            show-dates: root.show-dates;
                                            selected-id: root.selected-id;
                                            view-title: root.active-view == 0 ? (root.active-folder != "" ? "Folder" : (root.active-tag != "" ? "# " + root.active-tag : (root.pinned-section ? "" : "All notes"))) : root.active-view == 1 ? "Pinned" : root.active-view == 2 ? "Favorites" : root.active-view == 3 ? "Archive" : "Trash";
                                            active-view: root.active-view;
                                            search-text: root.search-text;
                                            columns: root.grid-cols;
                                             board-cols: root.board-cols;
                                             pin-item-w: root.board-pin-w;
                                             notes-item-w: root.board-notes-w;
                                             pin-block-h: root.board-pin-block-h;
                                             board-lefts: root.board-lefts;
                                             board-tops: root.board-tops;
                                             canvas-height: root.canvas-height;
                                             drag-target: root.drag-target;
                                             drag-target-x: root.drag-target-x;
                                             drag-target-y: root.drag-target-y;
                                             drag-target-h: root.drag-target-h;
                                            pinned-section: root.pinned-section;
                                            note-count: root.note-count;
                                            card-clicked(id) => { root.note-activated(id); }
                                            card-double-clicked(id) => { root.note-double-clicked(id); }
                                            pin-toggled(id) => { root.pin-toggled(id); }
                                            archive-toggled(id) => { root.card-archive(id); }
                                            trash-toggled(id) => { root.card-trash(id); }
                                            restore-toggled(id) => { root.card-restore(id); }
                                            delete-forever(id) => { root.card-delete-forever(id); }
                                            card-color-picked(id, idx) => { root.card-color-picked(id, idx); }
                                            card-export(id) => { root.card-export(id); }
                                            card-timestamps(id) => { root.card-timestamps(id); }
                                             card-checklist-toggle(id, line) => { root.card-checklist-toggle(id, line); }
                                            drag-reorder(id, idx) => { root.drag-reorder(id, idx); }
                                            drag-finish => { root.drag-finish(); }
                                             board-metrics(w) => { root.board-metrics(w); }
                                              composer-open <=> root.composer-open;
                                              composer-title <=> root.composer-title;
                                              composer-body <=> root.composer-body;
                                              composer-pinned <=> root.composer-pinned;
                                              composer-color-index <=> root.composer-color-index;
                                              composer-checklist-mode <=> root.composer-checklist-mode;
                                              composer-preview-mode <=> root.composer-preview-mode;
                                              composer-checklist-items <=> root.composer-checklist-items;
                                              composer-preview-styled: root.composer-preview-styled;
                                              composer-pending-images <=> root.composer-pending-images;
                                              composer-color-popover-open <=> root.composer-color-popover-open;
                                              composer-open-requested => { root.composer-open-requested(); }
                                              composer-close-requested => { root.composer-close-requested(); }
                                              composer-content-changed => { root.composer-content-changed(); }
                                              composer-toggle-pin => { root.composer-toggle-pin(); }
                                              composer-color-picked(idx) => { root.composer-color-picked(idx); }
                                              composer-image-requested => { root.composer-image-requested(); }
                                              composer-draw-requested => { root.composer-draw-requested(); }
                                              composer-checklist-toggle => { root.composer-checklist-toggle(); }
                                              composer-preview-toggle => { root.composer-preview-toggle(); }
                                              composer-checklist-add(text) => { root.composer-checklist-add(text); }
                                              composer-checklist-toggle-item(line) => { root.composer-checklist-toggle-item(line); }
                                              composer-checklist-edit-item(line, text) => { root.composer-checklist-edit-item(line, text); }
                                              composer-checklist-remove-item(line) => { root.composer-checklist-remove-item(line); }
                                              composer-remove-pending-image(id) => { root.composer-remove-pending-image(id); }
                                             drag-move-rust(x, y) => { root.drag-move-rust(x, y); }
                                            ask-empty-trash => { root.show-empty-trash = true; }
                                        }
                                    }
                                }
                            if root.layout-style != 2 && root.layout-style != 4 && root.compact && root.has-note:
                                EditorPane {
                                    horizontal-stretch: 1;
                                    height: root.height - 64px;
                                    compact: true;
                                    editor-title <=> root.editor-title;
                                    editor-body <=> root.editor-body;
                                    body-cursor-position <=> root.editor-body-cursor-position;
                                    body-height <=> root.editor-body-height;
                                    editor-tags <=> root.editor-tags;
                                    editor-pinned <=> root.editor-pinned;
                                    editor-favorite <=> root.editor-favorite;
                                    word-count <=> root.word-count;
                                    save-state <=> root.save-state;
                                    edited-label <=> root.edited-label;
                                    current-color-index <=> root.current-note-color-index;
                                    current-images <=> root.current-images;
                                    checklist-items <=> root.checklist-items;
                                    editor-markdown: root.editor-markdown;
                                    editor-links: root.editor-links;
                                    mode <=> root.editor-mode;
                                    checklist-mode <=> root.editor-checklist-mode;
                                    find-open <=> root.editor-find-open;
                                    find-query <=> root.editor-find-query;
                                    find-count <=> root.editor-find-count;
                                    find-index <=> root.editor-find-index;
                                    find-selection-offset <=> root.find-selection-offset;
                                    find-selection-length <=> root.find-selection-length;
                                    find-selection-token <=> root.find-selection-token;
                                    find-item <=> root.editor-find-item;
                                    in-trash: root.active-view == 4;
                                    in-archive: root.active-view == 3;
                                    folders: root.folders;
                                    current-folder: root.selected-folder-of-editor;
                                    content-changed => { root.editor-content-changed(); }
                                    toggle-pin => { root.toggle-pin-editor(); }
                                    more-toggled => { root.editor-more-popover-open = !root.editor-more-popover-open; }
                                    toggle-favorite => { root.toggle-favorite-editor(); }
                                    toggle-archive => { root.archive-editor(); }
                                    toggle-trash => { root.trash-editor(); }
                                    restore => { root.restore-editor(); }
                                    delete-forever => { root.show-delete-forever = true; }
                                    copy-note => { root.copy-editor(); }
                                    export-note => { root.export-editor(); }
                                    show-timestamps => { root.timestamps-open = true; }
                                    tag-added(text) => { root.tag-added(text); }
                                    tag-removed(text) => { root.tag-removed(text); }
                                    assign-folder(id) => { root.assign-folder(id); }
                                    color-picked(idx) => { root.color-picked(idx); }
                                    image-requested => { root.attach-images(); }
                                    draw-requested => { root.draw-editor(); }
                                    image-preview(id) => { root.image-preview(id); }
                                    image-delete(id) => { root.image-delete(id); }
                                    image-download(id) => { root.image-download(id); }
                                    checklist-toggle => { root.checklist-toggle(); }
                                    checklist-add(text) => { root.checklist-add(text); }
                                    checklist-toggle-item(line) => { root.checklist-toggle-item(line); }
                                    checklist-edit-item(line, text) => { root.checklist-edit-item(line, text); }
                                    checklist-remove-item(line) => { root.checklist-remove-item(line); }
                                    link-clicked(link) => { root.link-clicked(link); }
                                    find-changed => { root.find-changed(); }
                                    open-link => { root.open-link(); }
                                    find-next => { root.find-next(); }
                                    find-previous => { root.find-previous(); }
                                    close-find => { root.close-find(); }
                                    back => { root.back-to-list(); }
                                }

                            // desktop: full-width Keep board; a note opens as a modal editor
                            if root.layout-style != 2 && root.layout-style != 4 && !root.compact:
                                boardDesktop := Rectangle {
                                    width: 100%;
                                    height: root.height - 64px;
                                    background: Theme.bg;
                                    clip: true;
                                    VerticalLayout {
                                        padding-left: 18px;
                                        padding-right: 12px;
                                        padding-top: 8px;
                                        NoteListPanel { vertical-stretch: 1;
                                            horizontal-stretch: 1;
                                            pinned-notes: root.pinned-notes;
                                            notes: root.notes;
                                            list-view: root.list-view;
                                            layout-style: root.layout-style;
                                            density: root.density-setting;
                                            preview-lines: root.card-clamp;
                                            show-dates: root.show-dates;
                                            selected-id: root.selected-id;
                                            view-title: root.active-view == 0 ? (root.active-folder != "" ? "Folder" : (root.active-tag != "" ? "# " + root.active-tag : (root.pinned-section ? "" : "All notes"))) : root.active-view == 1 ? "Pinned" : root.active-view == 2 ? "Favorites" : root.active-view == 3 ? "Archive" : "Trash";
                                            active-view: root.active-view;
                                            search-text: root.search-text;
                                            columns: root.list-view ? 1 : root.grid-cols;
                                             board-cols: root.board-cols;
                                             pin-item-w: root.board-pin-w;
                                             notes-item-w: root.board-notes-w;
                                             pin-block-h: root.board-pin-block-h;
                                             board-lefts: root.board-lefts;
                                             board-tops: root.board-tops;
                                             canvas-height: root.canvas-height;
                                             drag-target: root.drag-target;
                                             drag-target-x: root.drag-target-x;
                                             drag-target-y: root.drag-target-y;
                                             drag-target-h: root.drag-target-h;
                                            pinned-section: root.pinned-section;
                                            note-count: root.note-count;
                                            card-clicked(id) => { root.note-activated(id); }
                                            card-double-clicked(id) => { root.note-double-clicked(id); }
                                            pin-toggled(id) => { root.pin-toggled(id); }
                                            archive-toggled(id) => { root.card-archive(id); }
                                            trash-toggled(id) => { root.card-trash(id); }
                                            restore-toggled(id) => { root.card-restore(id); }
                                            delete-forever(id) => { root.card-delete-forever(id); }
                                            card-color-picked(id, idx) => { root.card-color-picked(id, idx); }
                                            card-export(id) => { root.card-export(id); }
                                            card-timestamps(id) => { root.card-timestamps(id); }
                                             card-checklist-toggle(id, line) => { root.card-checklist-toggle(id, line); }
                                            drag-reorder(id, idx) => { root.drag-reorder(id, idx); }
                                            drag-finish => { root.drag-finish(); }
                                             board-metrics(w) => { root.board-metrics(w); }
                                              composer-open <=> root.composer-open;
                                              composer-title <=> root.composer-title;
                                              composer-body <=> root.composer-body;
                                              composer-pinned <=> root.composer-pinned;
                                              composer-color-index <=> root.composer-color-index;
                                              composer-checklist-mode <=> root.composer-checklist-mode;
                                              composer-preview-mode <=> root.composer-preview-mode;
                                              composer-checklist-items <=> root.composer-checklist-items;
                                              composer-preview-styled: root.composer-preview-styled;
                                              composer-pending-images <=> root.composer-pending-images;
                                              composer-color-popover-open <=> root.composer-color-popover-open;
                                              composer-open-requested => { root.composer-open-requested(); }
                                              composer-close-requested => { root.composer-close-requested(); }
                                              composer-content-changed => { root.composer-content-changed(); }
                                              composer-toggle-pin => { root.composer-toggle-pin(); }
                                              composer-color-picked(idx) => { root.composer-color-picked(idx); }
                                              composer-image-requested => { root.composer-image-requested(); }
                                              composer-draw-requested => { root.composer-draw-requested(); }
                                              composer-checklist-toggle => { root.composer-checklist-toggle(); }
                                              composer-preview-toggle => { root.composer-preview-toggle(); }
                                              composer-checklist-add(text) => { root.composer-checklist-add(text); }
                                              composer-checklist-toggle-item(line) => { root.composer-checklist-toggle-item(line); }
                                              composer-checklist-edit-item(line, text) => { root.composer-checklist-edit-item(line, text); }
                                              composer-checklist-remove-item(line) => { root.composer-checklist-remove-item(line); }
                                              composer-remove-pending-image(id) => { root.composer-remove-pending-image(id); }
                                             drag-move-rust(x, y) => { root.drag-move-rust(x, y); }
                                            ask-empty-trash => { root.show-empty-trash = true; }
                                        }
                                    }
                                }

                            if root.layout-style == 2:
                                VaultView {
                                    horizontal-stretch: 1;
                                    height: root.height - 64px;
                                    filter <=> root.vault-filter;
                                    source-mode <=> root.vault-source-mode;
                                    notes <=> root.vault-notes;
                                    selected-id: root.vault-selected-id;
                                    has-note: root.vault-has-note;
                                    doc-title <=> root.vault-title;
                                    doc-meta: root.vault-meta;
                                    doc-markdown: root.vault-markdown;
                                    doc-source <=> root.vault-source;
                                    links-out <=> root.vault-links-out;
                                    backlinks <=> root.vault-backlinks;
                                    pinned: root.vault-pinned;
                                    filter-changed(text) => { root.vault-filter-changed(text); }
                                    note-selected(id) => { root.vault-note-selected(id); }
                                    new-note => { root.vault-new-note(); }
                                    pin-toggled => { root.vault-pin-toggled(); }
                                    edit-source => { root.vault-edit-source(); }
                                    source-edited => { root.vault-source-edited(); }
                                    open-note => { root.vault-open(); }
                                    link-clicked(link) => { root.link-clicked(link); }
                                    title-edited(title) => { root.vault-title-edited(title); }
                                }

                            if root.layout-style == 4:
                                GraphView {
                                    horizontal-stretch: 1;
                                    height: root.height - 64px;
                                    nodes: root.graph-nodes;
                                    links: root.graph-links;
                                    has-selection <=> root.graph-has-selection;
                                    selected-id: root.graph-selected-id;
                                    selected-title <=> root.graph-selected-title;
                                    selected-meta: root.graph-selected-meta;
                                    selected-markdown: root.graph-selected-markdown;
                                    selected-links <=> root.graph-selected-links;
                                    graph-pointer-down(x, y, alt) => { root.graph-pointer-down(x, y, alt); }
                                    graph-pointer-move(x, y, alt) => { root.graph-pointer-move(x, y, alt); }
                                    graph-pointer-up(x, y, alt) => { root.graph-pointer-up(x, y, alt); }
                                    graph-wheel(delta, alt) => { root.graph-wheel(delta, alt); }
                                    relabel => { root.graph-relabel(); }
                                    close-selection => { root.graph-close-selection(); }
                                    open-note => { root.graph-open-note(); }
                                    unlink-all => { root.graph-unlink-all(); }
                                    link-clicked(link) => { root.link-clicked(link); }
                                }
                            // desktop: modal editor (opens when a note is open, any layout)
                            // always present for fade in/out; hit-testing gated by has-note
                            editorScrim := Rectangle {
                                width: 100%; height: 100%;
                                visible: root.modal-showing;
                                opacity: root.has-note ? 1.0 : 0.0;
                                animate opacity { duration: 180ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                                background: Theme.scrim;
                                TouchArea { enabled: root.has-note; clicked => { root.back-to-list(); } }
                                modalCard := Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: min(560px, parent.width - 32px);
                                    height: min(parent.height - 64px, max(160px, root.editor-body-height + 106px));
                                    border-radius: Theme.r-md;
                                    background: Theme.neo ? Theme.neo-card : (root.current-note-color-index == 0 ? Theme.card-bg : Theme.note-color(root.current-note-color-index));
                                    border-width: 0px;
                                    clip: true;
                                    drop-shadow-blur: 32px;
                                    drop-shadow-offset-y: 8px;
                                    drop-shadow-color: #00000060;
                                    EditorPane { width: 100%; height: 100%; compact: false;
                                            editor-title <=> root.editor-title;
                                            editor-body <=> root.editor-body;
                                    body-cursor-position <=> root.editor-body-cursor-position;
                                    body-height <=> root.editor-body-height;
                                            editor-tags <=> root.editor-tags;
                                            editor-pinned <=> root.editor-pinned;
                                            editor-favorite <=> root.editor-favorite;
                                            word-count <=> root.word-count;
                                            save-state <=> root.save-state;
                                            edited-label <=> root.edited-label;
                                            more-toggled => { root.editor-more-popover-open = !root.editor-more-popover-open; }
                                            current-color-index <=> root.current-note-color-index;
                                            current-images <=> root.current-images;
                                            checklist-items <=> root.checklist-items;
                                            editor-markdown: root.editor-markdown;
                                            editor-links: root.editor-links;
                                            mode <=> root.editor-mode;
                                            checklist-mode <=> root.editor-checklist-mode;
                                            find-open <=> root.editor-find-open;
                                            find-query <=> root.editor-find-query;
                                            find-count <=> root.editor-find-count;
                                            find-index <=> root.editor-find-index;
                                            find-selection-offset <=> root.find-selection-offset;
                                            find-selection-length <=> root.find-selection-length;
                                            find-selection-token <=> root.find-selection-token;
                                            in-trash: root.active-view == 4;
                                            in-archive: root.active-view == 3;
                                            folders: root.folders;
                                            current-folder: root.selected-folder-of-editor;
                                            content-changed => { root.editor-content-changed(); }
                                            toggle-pin => { root.toggle-pin-editor(); }
                                            toggle-favorite => { root.toggle-favorite-editor(); }
                                            toggle-archive => { root.archive-editor(); }
                                            toggle-trash => { root.trash-editor(); }
                                            restore => { root.restore-editor(); }
                                            delete-forever => { root.show-delete-forever = true; }
                                            copy-note => { root.copy-editor(); }
                                            export-note => { root.export-editor(); }
                                            show-timestamps => { root.timestamps-open = true; }
                                            tag-added(text) => { root.tag-added(text); }
                                            tag-removed(text) => { root.tag-removed(text); }
                                            assign-folder(id) => { root.assign-folder(id); }
                                            color-picked(idx) => { root.color-picked(idx); }
                                            image-requested => { root.attach-images(); }
                                            draw-requested => { root.draw-editor(); }
                                            image-preview(id) => { root.image-preview(id); }
                                            image-delete(id) => { root.image-delete(id); }
                                    image-download(id) => { root.image-download(id); }
                                            checklist-toggle => { root.checklist-toggle(); }
                                            checklist-add(text) => { root.checklist-add(text); }
                                            checklist-toggle-item(line) => { root.checklist-toggle-item(line); }
                                            checklist-edit-item(line, text) => { root.checklist-edit-item(line, text); }
                                            checklist-remove-item(line) => { root.checklist-remove-item(line); }
                                            link-clicked(link) => { root.link-clicked(link); }
                                            find-changed => { root.find-changed(); }
                                    open-link => { root.open-link(); }
                                            find-next => { root.find-next(); }
                                            find-previous => { root.find-previous(); }
                                            close-find => { root.close-find(); }
                                            back => { root.back-to-list(); }
                                        }
                                    }
                                }
                        }
                    }
            }

                // ===== Editor More popover (web #ed-more-pop), screen-level overlay =====
                // Web: width min(300px, vpw-16px), padding 12px, border var(--border),
                // radius var(--radius)=12px, shadow var(--shadow-2); labels 11px uppercase
                // 500 letter-spacing .04em var(--text-sec); colours circular 6x2 gap 8px
                // selected inset -4px 2px var(--text); format 4-col gap 5px height 32px
                // bg var(--icon-hover-bg) radius 3px font 11.5px; pop-items padding 9px 10px
                // font 13.5px svg 18px radius 5px; positioned to More button (left, below/flip).
                if root.editor-more-popover-open:
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        TouchArea { clicked => { root.editor-more-popover-open = false; } }
                        Rectangle {
                            x: max(8px, min(parent.width - 308px, (parent.width - min(560px, parent.width - 32px)) / 2 + min(560px, parent.width - 32px) - 108px));
                            y: max(8px, 64px + (parent.height - 64px - min(parent.height - 64px, max(160px, root.editor-body-height + 106px))) / 2 + min(parent.height - 64px, max(160px, root.editor-body-height + 106px)) - 560px);
                            width: min(300px, parent.width - 16px);
                            height: 510px;
                            background: Theme.surface;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.border;
                            drop-shadow-blur: 16px;
                            drop-shadow-offset-y: 2px;
                            drop-shadow-color: #00000060;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;
                                Text { text: "BACKGROUND"; font-size: 11px; color: Theme.text-dim; font-weight: 500; letter-spacing: 0.44px; }
                                Rectangle {
                                    height: 90px;
                                    VerticalLayout {
                                        spacing: 8px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            for idx[i] in [0, 1, 2, 3, 4, 5]:
                                                TouchArea {
                                                    width: 38px;
                                                    height: 38px;
                                                    mouse-cursor: pointer;
                                                    clicked => { root.color-picked(idx); }
                                                    Rectangle {
                                                        width: 38px;
                                                        height: 38px;
                                                        border-radius: 19px;
                                                        background: idx == 0 ? Theme.card-bg : Theme.note-color(idx);
                                                        border-width: 1px;
                                                        border-color: Theme.border;
                                                    }
                                                    if root.current-note-color-index == idx:
                                                        Rectangle {
                                                            x: -4px;
                                                            y: -4px;
                                                            width: 46px;
                                                            height: 46px;
                                                            border-radius: 23px;
                                                            border-width: 2px;
                                                            border-color: Theme.text;
                                                        }
                                                }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            for idx[i] in [6, 7, 8, 9, 10, 11]:
                                                TouchArea {
                                                    width: 38px;
                                                    height: 38px;
                                                    mouse-cursor: pointer;
                                                    clicked => { root.color-picked(idx); }
                                                    Rectangle {
                                                        width: 38px;
                                                        height: 38px;
                                                        border-radius: 19px;
                                                        background: Theme.note-color(idx);
                                                        border-width: 1px;
                                                        border-color: Theme.border;
                                                    }
                                                    if root.current-note-color-index == idx:
                                                        Rectangle {
                                                            x: -4px;
                                                            y: -4px;
                                                            width: 46px;
                                                            height: 46px;
                                                            border-radius: 23px;
                                                            border-width: 2px;
                                                            border-color: Theme.text;
                                                        }
                                                }
                                        }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.divider; }
                                Rectangle {
                                    height: 36px;
                                    border-radius: 5px;
                                    background: edI.has-hover ? Theme.icon-hover-bg : transparent;
                                    edI := TouchArea { mouse-cursor: pointer; clicked => { root.editor-more-popover-open = false; root.attach-images(); } }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 10px;
                                        IconImage { stroke-color: Theme.icon; width: 18px; height: 18px; }
                                        Text { text: "Add image"; font-size: 13.5px; color: Theme.text; }
                                    }
                                }
                                Rectangle {
                                    height: 36px;
                                    border-radius: 5px;
                                    background: edW.has-hover ? Theme.icon-hover-bg : transparent;
                                    edW := TouchArea { mouse-cursor: pointer; clicked => { root.editor-more-popover-open = false; root.draw-editor(); } }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 10px;
                                        IconPencil { stroke-color: Theme.icon; width: 18px; height: 18px; }
                                        Text { text: "Draw a doodle"; font-size: 13.5px; color: Theme.text; }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.divider; }
                                Text { text: "FORMATTING"; font-size: 11px; color: Theme.text-dim; font-weight: 500; letter-spacing: 0.44px; }
                                Rectangle {
                                    height: 143px;
                                    VerticalLayout {
                                        spacing: 5px;
                                        HorizontalLayout {
                                            spacing: 5px;
                                            for label[i] in ["B", "I", "U", "S"]:
                                                edB := TouchArea {
                                                    width: 65px;
                                                    height: 32px;
                                                    mouse-cursor: pointer;
                                                    clicked => { root.format-tool(i == 0 ? "bold" : i == 1 ? "italic" : i == 2 ? "underline" : "strike"); }
                                                    Rectangle {
                                                        width: 65px;
                                                        height: 32px;
                                                        border-radius: 3px;
                                                        background: edB.has-hover ? Theme.surface-2 : Theme.icon-hover-bg;
                                                    }
                                                    Text {
                                                        text: label;
                                                        font-size: 11.5px;
                                                        color: Theme.text-dim;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                        }
                                        HorizontalLayout {
                                            spacing: 5px;
                                            for label[i] in ["code", "H1", "H2", "H3"]:
                                                edB2 := TouchArea {
                                                    width: 65px;
                                                    height: 32px;
                                                    mouse-cursor: pointer;
                                                    clicked => { root.format-tool(i == 0 ? "code" : i == 1 ? "h1" : i == 2 ? "h2" : "h3"); }
                                                    Rectangle {
                                                        width: 65px;
                                                        height: 32px;
                                                        border-radius: 3px;
                                                        background: edB2.has-hover ? Theme.surface-2 : Theme.icon-hover-bg;
                                                    }
                                                    Text {
                                                        text: label;
                                                        font-size: 11.5px;
                                                        color: Theme.text-dim;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                        }
                                        HorizontalLayout {
                                            spacing: 5px;
                                            for label[i] in ["quote", "list", "1.", "task"]:
                                                edB3 := TouchArea {
                                                    width: 65px;
                                                    height: 32px;
                                                    mouse-cursor: pointer;
                                                    clicked => { root.format-tool(i == 0 ? "quote" : i == 1 ? "ul" : i == 2 ? "ol" : "task"); }
                                                    Rectangle {
                                                        width: 65px;
                                                        height: 32px;
                                                        border-radius: 3px;
                                                        background: edB3.has-hover ? Theme.surface-2 : Theme.icon-hover-bg;
                                                    }
                                                    Text {
                                                        text: label;
                                                        font-size: 11.5px;
                                                        color: Theme.text-dim;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                        }
                                        HorizontalLayout {
                                            spacing: 5px;
                                            for label[i] in ["link", "wiki", "table", "div"]:
                                                edB4 := TouchArea {
                                                    width: 65px;
                                                    height: 32px;
                                                    mouse-cursor: pointer;
                                                    clicked => { root.format-tool(i == 0 ? "link" : i == 1 ? "wiki" : i == 2 ? "table" : "div"); }
                                                    Rectangle {
                                                        width: 65px;
                                                        height: 32px;
                                                        border-radius: 3px;
                                                        background: edB4.has-hover ? Theme.surface-2 : Theme.icon-hover-bg;
                                                    }
                                                    Text {
                                                        text: label;
                                                        font-size: 11.5px;
                                                        color: Theme.text-dim;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                        }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.divider; }
                                Rectangle {
                                    height: 36px;
                                    border-radius: 5px;
                                    background: edT.has-hover ? Theme.icon-hover-bg : transparent;
                                    edT := TouchArea { mouse-cursor: pointer; clicked => { root.editor-more-popover-open = false; root.export-note-txt(); } }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 10px;
                                        IconDownload { stroke-color: Theme.icon; width: 18px; height: 18px; }
                                        Text { text: "Download .txt"; font-size: 13.5px; color: Theme.text; }
                                    }
                                }
                                Rectangle {
                                    height: 36px;
                                    border-radius: 5px;
                                    background: edM.has-hover ? Theme.icon-hover-bg : transparent;
                                    edM := TouchArea { mouse-cursor: pointer; clicked => { root.editor-more-popover-open = false; root.export-editor(); } }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 10px;
                                        IconDownload { stroke-color: Theme.icon; width: 18px; height: 18px; }
                                        Text { text: "Download .md"; font-size: 13.5px; color: Theme.text; }
                                    }
                                }
                            }
                        }
                    }

                // ===== link suggestions =====
                if root.editor-suggestions-visible:
                    Rectangle {
                        x: root.width > 1000px ? 250px : 18px;
                        y: 210px;
                        width: 280px;
                        height: min(240px, suggestions.preferred-height + 12px);
                        border-radius: Theme.r-md;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border-strong;
                        drop-shadow-blur: 20px;
                        drop-shadow-color: #00000060;
                        suggestions := VerticalLayout {
                            padding: 6px;
                            spacing: 2px;
                            Text { text: "LINK TO NOTE"; font-size: 9.5px; font-weight: 700; letter-spacing: 1px; color: Theme.text-faint; }
                            for suggestion[i] in root.editor-suggestions:
                                suggestionRow := TouchArea {
                                    height: 30px;
                                    clicked => { root.suggestion-picked(suggestion); }
                                    Rectangle { border-radius: Theme.r-sm; background: suggestionRow.has-hover ? Theme.surface-2 : transparent; }
                                    Text { x: 8px; y: 0; height: 100%; vertical-alignment: center; text: suggestion; font-size: 12.5px; color: Theme.text; }
                                }
                        }
                    }

                // ===== overlays =====
                if root.doodle-open:
                    DoodleOverlay {
                        strokes: root.doodle-strokes;
                        pen-color <=> root.doodle-pen-color;
                        pen-size <=> root.doodle-pen-size;
                        draw-down(x, y, shift) => { root.doodle-draw-down(x, y, shift); }
                        draw-move(x, y, shift) => { root.doodle-draw-move(x, y, shift); }
                        draw-up(x, y) => { root.doodle-draw-up(x, y); }
                        undo => { root.doodle-undo(); }
                        clear => { root.doodle-clear(); }
                        cancel => { root.doodle-cancel(); }
                        save => { root.doodle-save(); }
                    }

                if root.show-settings:
                    SettingsView {
                        dark <=> root.dark;
                        neo <=> root.neo;
                        layout <=> root.layout-style;
                        density <=> root.density-setting;
                        mobile-two <=> root.mobile-two;
                        sort <=> root.sort-setting;
                        pinned-first <=> root.pinned-first;
                        md-cards <=> root.md-cards;
                        show-dates <=> root.show-dates;
                        clamp <=> root.card-clamp;
                        vault-enabled: root.vault-enabled;
                        security-mode <=> root.settings-security-mode;
                        password-strength <=> root.settings-password-strength;
                        password-edited => { root.password-edited(); }
                        new-password <=> root.settings-new-password;
                        confirm-password <=> root.settings-confirm-password;
                        current-password <=> root.settings-current-password;
                        reset-acknowledged <=> root.settings-reset-acknowledged;
                        security-error <=> root.settings-security-error;
                        stats-text: root.settings-stats;
                        about-version: root.app-version;
                        close => { root.show-settings = false; }
                        theme-selected(choice) => { if choice != Theme.dark { root.toggle-theme(); } }
                        layout-selected(choice) => { root.layout-selected(choice); }
                        density-selected(choice) => { root.settings-density-selected(choice); }
                        mobile-two-toggled => { root.settings-toggle-mobile-two(); }
                        sort-selected(choice) => { root.settings-sort-selected(choice); }
                        pinned-first-toggled => { root.settings-toggle-pinned-first(); }
                        md-cards-toggled => { root.settings-toggle-md-cards(); }
                        show-dates-toggled => { root.settings-toggle-show-dates(); }
                        clamp-selected(choice) => { root.settings-clamp-selected(choice); }
                        markdown-guide => { root.markdown-guide(); }
                        import-md => { root.import-md(); }
                        export-all => { root.export-all-md(); }
                        empty-trash => { root.show-empty-trash = true; }
                        create-vault(pass, confirm) => { root.create-vault(pass, confirm); }
                        change-password(cur, newpass) => { root.change-password(cur, newpass); }
                        reset-password(newpass, confirm, ack) => { root.reset-password(newpass, confirm, ack); }
                        lock-now => { root.lock-now(); }
                    }

                if root.show-markdown-guide:
                    MarkdownGuide { closed => { root.show-markdown-guide = false; } }

                if root.timestamps-open:
                    timestamps := Rectangle {
                        width: 100%; height: 100%; background: Theme.scrim;
                        TouchArea { clicked => { root.timestamps-open = false; } }
                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2 - 40px;
                            width: min(430px, parent.width - 48px);
                            height: min(480px, parent.height - 48px);
                            border-radius: Theme.r-lg;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            VerticalLayout {
                                padding: 22px;
                                spacing: 10px;
                                Text { text: root.timestamps-title + " — timestamps"; font-size: 17px; font-weight: 650; color: Theme.text; }
                                HorizontalLayout {
                                    Text { text: "Created"; font-size: 12px; color: Theme.text-faint; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: root.timestamp-created; font-size: 12px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                                }
                                HorizontalLayout {
                                    Text { text: "Last edited"; font-size: 12px; color: Theme.text-faint; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: root.timestamp-edited; font-size: 12px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                Text { text: "ACTIVITY"; font-size: 10.5px; font-weight: 700; letter-spacing: 1px; color: Theme.text-faint; }
                                Flickable {
                                    vertical-stretch: 1;
                                    content-height: activityList.preferred-height;
                                    activityList := VerticalLayout {
                                        spacing: 6px;
                                        for activity[i] in root.timestamp-activity:
                                            Text { text: "•  " + activity; font-size: 12px; color: Theme.text-dim; }
                                        if root.timestamp-activity.length == 0:
                                            Text { text: "No activity recorded yet."; font-size: 12px; color: Theme.text-faint; }
                                    }
                                }
                                HorizontalLayout { alignment: end; TextButton { label: "Close"; emphasis: true; clicked => { root.timestamps-open = false; } } }
                            }
                        }
                    }

                if root.image-preview-open:
                    lightbox := Rectangle {
                        width: 100%; height: 100%; background: rgba(0,0,0,0.82);
                        TouchArea { clicked => { root.close-image-preview(); } }
                        Rectangle {
                            x: parent.width - 66px; y: 18px; width: 48px; height: 48px;
                            border-radius: 24px;
                            background: rgba(32,33,36,0.6);
                            TouchArea { mouse-cursor: pointer; clicked => { root.close-image-preview(); } }
                            Text { x: 0px; y: 0px; width: 100%; height: 100%; text: "×"; font-size: 25px; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Image {
                            x: (parent.width - min(parent.width - parent.width / 12, 1100px)) / 2;
                            y: 24px; width: min(parent.width - parent.width / 12, 1100px); height: parent.height - parent.height / 8 - 48px;
                            source: root.image-preview-image;
                            image-fit: contain;
                        }
                        HorizontalLayout {
                            x: 40px; y: parent.height - 62px; width: parent.width - 80px; height: 30px;
                            Text { text: root.image-preview-name + "  ·  " + root.image-preview-size; font-size: 12px; color: #e8eaed; vertical-alignment: center; horizontal-stretch: 1; }
                            TextButton { label: "Download " + root.image-preview-name; emphasis: true; clicked => { root.image-download-preview(); } }
                        }
                    }

                // Compact (phone) drawer: overlay panel + scrim, like web
                // `.drawer { width: min(280px, 80vw); top: 56px }` + `.drawer-scrim`.
                if root.compact && root.sidebar-open:
                    Rectangle {
                        x: 0px; y: 56px; width: 100%; height: 100%;
                        // Web .drawer-scrim is a transparent click-catcher.
                        background: transparent;
                        TouchArea { clicked => { root.sidebar-open = false; } }
                    }
                    Rectangle {
                        x: 0px; y: 56px;
                        width: min(280px, parent.width - parent.width / 5);
                        height: parent.height - 56px;
                        background: Theme.drawer-bg;
                        clip: true;
                        VerticalLayout {
                            padding-left: 13px;
                            padding-right: 14px;
                            padding-top: 12px;
                            padding-bottom: 10px;
                            Flickable {
                                vertical-stretch: 1;
                                content-width: self.width;
                                content-height: menu.preferred-height;
                                menu := DrawerMenu {
                                    y: 0px;
                                    width: parent.width;
                                    active-view: root.active-view;
                                    active-folder: root.active-folder;
                                    active-tag: root.active-tag;
                                    layout-style: root.layout-style;
                                    dark: root.dark;
                                    live-count: root.drawer-live-count;
                                    pinned-count: root.drawer-pinned-count;
                                    archive-count: root.drawer-archive-count;
                                    trash-count: root.drawer-trash-count;
                                    folders: root.folders;
                                    tags: root.tags;
                                    new-folder-open <=> root.new-folder-open;
                                    new-folder-name <=> root.new-folder-name;
                                    view-selected(v) => { root.sidebar-open = false; root.view-selected(v); }
                                    layout-selected(v) => { root.sidebar-open = false; root.layout-selected(v); }
                                    toggle-theme() => { root.sidebar-open = false; root.toggle-theme(); }
                                    new-folder() => { root.new-folder(); }
                                    create-folder(n) => { root.create-folder(n); }
                                    cancel-new-folder() => { root.cancel-new-folder(); }
                                    folder-selected(id) => { root.sidebar-open = false; root.folder-selected(id); }
                                    delete-folder(id) => { root.delete-folder(id); }
                                    tag-selected(n) => { root.sidebar-open = false; root.tag-selected(n); }
                                    empty-trash-requested() => { root.sidebar-open = false; root.show-empty-trash = true; }
                                    settings-requested() => { root.sidebar-open = false; root.show-settings = true; }
                                }
                            }
                        }
                    }

                if root.show-delete-forever:
                    ConfirmDialog {
                        title: "Delete forever?";
                        message: "This note and its attachments will be permanently deleted. This action cannot be undone.";
                        confirm-label: "Delete";
                        danger: true;
                        confirmed => { root.delete-forever-confirmed(); }
                        cancelled => { root.show-delete-forever = false; }
                    }

                if root.show-empty-trash:
                    ConfirmDialog {
                        title: "Empty trash?";
                        message: "All notes in Trash and their attachments will be permanently deleted. This action cannot be undone.";
                        confirm-label: "Empty trash";
                        danger: true;
                        confirmed => { root.empty-trash-confirmed(); }
                        cancelled => { root.show-empty-trash = false; }
                    }

                if root.toast-visible:
                    Toast {
                        width: max(220px, self.preferred-width);
                        x: (app.width - self.width) / 2;
                        y: app.height - 80px;
                        message: root.toast-message;
                    }
            }
    }
}

                                    checklist-toggle-item(line) => { root.checklist-toggle-item(line); }
                                    checklist-edit-item(line, text) => { root.checklist-edit-item(line, text); }
                                    checklist-remove-item(line) => { root.checklist-remove-item(line); }
                                    link-clicked(link) => { root.link-clicked(link); }
                                    find-changed => { root.find-changed(); }
                                    find-next => { root.find-next(); }
                                    find-previous => { root.find-previous(); }
                                    close-find => { root.close-find(); }
                                    back => { root.back-to-list(); }
                                }
                        if root.layout-style != 2 && root.layout-style != 4 && !root.compact:
                                boardDesktopPane := Rectangle {
                                    horizontal-stretch: 1;
                                    height: 100%;
                                    background: Theme.bg;
                                    clip: true;
                                    VerticalLayout {
                                        padding-left: 18px;
                                        padding-right: 18px;
                                        padding-top: 10px;
                                        preferred-height: 1px;
                                        HorizontalLayout { alignment: center; NewNoteComposer { width: 680px; height: root.composer-open ? 230px : 76px; open <=> root.composer-open; title <=> root.composer-title; body <=> root.composer-body; pinned <=> root.composer-pinned; color-index <=> root.composer-color-index; checklist-mode <=> root.composer-checklist-mode; preview-mode <=> root.composer-preview-mode; checklist-items <=> root.composer-checklist-items; preview-styled: root.composer-preview-styled; pending-images <=> root.composer-pending-images; color-popover-open <=> root.composer-color-popover-open; open-requested => { root.composer-open-requested(); } close-requested => { root.composer-close-requested(); } content-changed => { root.composer-content-changed(); } toggle-pin => { root.composer-toggle-pin(); } color-picked(idx) => { root.composer-color-picked(idx); } image-requested => { root.composer-image-requested(); } draw-requested => { root.composer-draw-requested(); } checklist-toggle => { root.composer-checklist-toggle(); } preview-toggle => { root.composer-preview-toggle(); } checklist-add(text) => { root.composer-checklist-add(text); } checklist-toggle-item(line) => { root.composer-checklist-toggle-item(line); } checklist-edit-item(line, text) => { root.composer-checklist-edit-item(line, text); } checklist-remove-item(line) => { root.composer-checklist-remove-item(line); } remove-pending-image(id) => { root.composer-remove-pending-image(id); } } }
                                        NoteListPanel { vertical-stretch: 1; height: 340px;
                                            horizontal-stretch: 1;
                                            pinned-notes: root.pinned-notes;
                                            notes: root.notes;
                                            pinned-col-0: root.pinned-col-0; pinned-col-1: root.pinned-col-1; pinned-col-2: root.pinned-col-2; pinned-col-3: root.pinned-col-3; pinned-col-4: root.pinned-col-4;
                                            notes-col-0: root.notes-col-0; notes-col-1: root.notes-col-1; notes-col-2: root.notes-col-2; notes-col-3: root.notes-col-3; notes-col-4: root.notes-col-4;
                                            list-view: root.list-view;
                                            layout-style: root.layout-style;
                                            density: root.density-setting;
                                            preview-lines: root.card-clamp;
                                            show-dates: root.show-dates;
                                            selected-id: root.selected-id;
                                            view-title: root.active-view == 0 ? (root.active-folder != "" ? "Folder" : (root.active-tag != "" ? "# " + root.active-tag : "ALL NOTES")) : root.active-view == 1 ? "PINNED" : root.active-view == 2 ? "FAVORITES" : root.active-view == 3 ? "ARCHIVE" : "TRASH";
                                            active-view: root.active-view;
                                            search-text: root.search-text;
                                            columns: root.grid-cols;
                                            pinned-section: root.pinned-section;
                                            note-count: root.note-count;
                                            manual-order: root.sort-setting == 3 && (root.layout-style == 1 || root.list-view);
                                            card-clicked(id) => { root.note-activated(id); }

                                            manual-note-moved(id, direction) => { root.manual-note-moved(id, direction); }
                                            ask-empty-trash => { root.show-empty-trash = true; }
                                        }
                                    }
                                }

                        if root.layout-style == 2:
                            VaultView {
                                horizontal-stretch: 1;
                                filter <=> root.vault-filter;
                                source-mode <=> root.vault-source-mode;
                                notes <=> root.vault-notes;
                                selected-id: root.vault-selected-id;
                                has-note: root.vault-has-note;
                                doc-title <=> root.vault-title;
                                doc-meta: root.vault-meta;
                                doc-markdown: root.vault-markdown;
                                doc-source <=> root.vault-source;
                                links-out <=> root.vault-links-out;
                                backlinks <=> root.vault-backlinks;
                                pinned: root.vault-pinned;
                                filter-changed(text) => { root.vault-filter-changed(text); }
                                note-selected(id) => { root.vault-note-selected(id); }
                                new-note => { root.vault-new-note(); }
                                pin-toggled => { root.vault-pin-toggled(); }
                                edit-source => { root.vault-edit-source(); }
                                source-edited => { root.vault-source-edited(); }
                                open-note => { root.vault-open(); }
                                link-clicked(link) => { root.link-clicked(link); }
                                title-edited(title) => { root.vault-title-edited(title); }
                            }

                        if root.layout-style == 4:
                            GraphView {
                                horizontal-stretch: 1;
                                nodes: root.graph-nodes;
                                links: root.graph-links;
                                has-selection <=> root.graph-has-selection;
                                selected-id: root.graph-selected-id;
                                selected-title <=> root.graph-selected-title;
                                selected-meta: root.graph-selected-meta;
                                selected-markdown: root.graph-selected-markdown;
                                selected-links <=> root.graph-selected-links;
                                graph-pointer-down(x, y, alt) => { root.graph-pointer-down(x, y, alt); }
                                graph-pointer-move(x, y, alt) => { root.graph-pointer-move(x, y, alt); }
                                graph-pointer-up(x, y, alt) => { root.graph-pointer-up(x, y, alt); }
                                graph-wheel(delta, alt) => { root.graph-wheel(delta, alt); }
                                relabel => { root.graph-relabel(); }
                                close-selection => { root.graph-close-selection(); }
                                open-note => { root.graph-open-note(); }
                                unlink-all => { root.graph-unlink-all(); }
                                link-clicked(link) => { root.link-clicked(link); }
                            }
                    }

                    // ===== STATUS BAR =====
                    Rectangle {
                        height: 26px;
                        Rectangle { y: 0; width: parent.width; height: 1px; background: Theme.border; }
                        HorizontalLayout {
                            padding-left: 16px; padding-right: 16px; spacing: 8px;
                            Text { text: root.vault-enabled ? "Local-first · Vault encrypted" : "Local-first · Plaintext"; font-size: 10.5px; color: Theme.text-faint; vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: root.note-count + " notes"; font-size: 10.5px; color: Theme.text-faint; vertical-alignment: center; }
                        }
                    }
                }

                // ===== editor modal (desktop/board/vault/graph) =====
                if root.has-note && !root.compact:
                    editorScrim := Rectangle {
                        x: Theme.rail-width;
                        y: Theme.topbar-height;
                        width: root.width - Theme.rail-width;
                        height: root.height - Theme.topbar-height - 26px;
                        background: Theme.bg;
                        EditorPane {
                                width: 100%; height: 100%; compact: false;
                                editor-title <=> root.editor-title;
                                editor-body <=> root.editor-body;
                                editor-tags <=> root.editor-tags;
                                editor-pinned <=> root.editor-pinned;
                                editor-favorite <=> root.editor-favorite;
                                word-count <=> root.word-count;
                                save-state <=> root.save-state;
                                edited-label <=> root.edited-label;
                                folder-menu-open <=> root.folder-menu-open;
                                color-popover-open <=> root.color-popover-open;
                                current-color-index <=> root.current-note-color-index;

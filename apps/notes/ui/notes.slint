                        draw-down(x, y, shift) => { root.doodle-draw-down(x, y, shift); }
                        draw-move(x, y, shift) => { root.doodle-draw-move(x, y, shift); }
                        draw-up(x, y) => { root.doodle-draw-up(x, y); }
                        undo => { root.doodle-undo(); }
                        clear => { root.doodle-clear(); }
                        cancel => { root.doodle-cancel(); }
                        save => { root.doodle-save(); }
                    }


                                            view-title: root.active-view == 0 ? (root.active-folder != "" ? "Folder" : (root.active-tag != "" ? "# " + root.active-tag : "ALL NOTES")) : root.active-view == 1 ? "PINNED" : root.active-view == 2 ? "FAVORITES" : root.active-view == 3 ? "ARCHIVE" : "TRASH";
                                            active-view: root.active-view;
                                            search-text: root.search-text;
                                            columns: root.grid-cols;
                                            pinned-section: root.pinned-section;
                                            note-count: root.note-count;
                                            manual-order: root.sort-setting == 3 && (root.layout-style == 1 || root.list-view);
                                            card-clicked(id) => { root.note-activated(id); }

                                            manual-note-moved(id, direction) => { root.manual-note-moved(id, direction); }
                                            ask-empty-trash => { root.show-empty-trash = true; }
                                        }
                                    }
                                }
                        if root.layout-style != 2 && root.layout-style != 4 && root.compact && root.has-note:
                                EditorPane {
                                    horizontal-stretch: 1;
                                    compact: true;

                                editor-markdown: root.editor-markdown;
                                editor-links: root.editor-links;
                                mode <=> root.editor-mode;
                                checklist-mode <=> root.editor-checklist-mode;
                                find-open <=> root.editor-find-open;
                                find-query <=> root.editor-find-query;
                                find-count <=> root.editor-find-count;
                                find-index <=> root.editor-find-index;
                                    find-selection-offset <=> root.find-selection-offset;
                                    find-selection-length <=> root.find-selection-length;
                                    find-selection-token <=> root.find-selection-token;
                                in-trash: root.active-view == 4;
                                in-archive: root.active-view == 3;
                                folders: root.folders;
                                current-folder: root.selected-folder-of-editor;
                                content-changed => { root.editor-content-changed(); }
                                toggle-pin => { root.toggle-pin-editor(); }
                                toggle-favorite => { root.toggle-favorite-editor(); }
                                toggle-archive => { root.archive-editor(); }
                                toggle-trash => { root.trash-editor(); }
                                restore => { root.restore-editor(); }
                                delete-forever => { root.show-delete-forever = true; }
                                copy-note => { root.copy-editor(); }
                                export-note => { root.export-editor(); }
                                show-timestamps => { root.timestamps-open = true; }
                                tag-added(text) => { root.tag-added(text); }
                                tag-removed(text) => { root.tag-removed(text); }
                                assign-folder(id) => { root.assign-folder(id); }
                                color-picked(idx) => { root.color-picked(idx); }
                                image-requested => { root.attach-images(); }
                                draw-requested => { root.draw-editor(); }
                                image-preview(id) => { root.image-preview(id); }
                                image-delete(id) => { root.image-delete(id); }
                                checklist-toggle => { root.checklist-toggle(); }
                                checklist-add(text) => { root.checklist-add(text); }
                                checklist-toggle-item(line) => { root.checklist-toggle-item(line); }
                                checklist-edit-item(line, text) => { root.checklist-edit-item(line, text); }
                                checklist-remove-item(line) => { root.checklist-remove-item(line); }
                                link-clicked(link) => { root.link-clicked(link); }
                                find-changed => { root.find-changed(); }
                                find-next => { root.find-next(); }
                                find-previous => { root.find-previous(); }
                                close-find => { root.close-find(); }
                                back => { root.back-to-list(); }
                            }
                    }

                // ===== link suggestions =====
                if root.editor-suggestions-visible:
                    Rectangle {
                        x: root.width > 1000px ? 250px : 18px;
                        y: 210px;
                        width: 280px;
                        height: min(240px, suggestions.preferred-height + 12px);
                        border-radius: Theme.r-md;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border-strong;
                        drop-shadow-blur: 20px;
                        drop-shadow-color: #00000060;
                        suggestions := VerticalLayout {
                            padding: 6px;
                            spacing: 2px;
                            Text { text: "LINK TO NOTE"; font-size: 9.5px; font-weight: 700; letter-spacing: 1px; color: Theme.text-faint; }
                            for suggestion[i] in root.editor-suggestions:
                                suggestionRow := TouchArea {
                                    height: 30px;
                                    clicked => { root.suggestion-picked(suggestion); }
                                    Rectangle { border-radius: Theme.r-sm; background: suggestionRow.has-hover ? Theme.surface-2 : transparent; }
                                    Text { x: 8px; y: 0; height: 100%; vertical-alignment: center; text: suggestion; font-size: 12.5px; color: Theme.text; }
                                }
                        }
                    }

                // ===== overlays =====
                if root.doodle-open:
                    DoodleOverlay {

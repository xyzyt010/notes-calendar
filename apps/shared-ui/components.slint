// Shared custom widgets for the yellod apps. Pure Slint, themeable via Theme.

import { Theme } from "theme.slint";
import {
    IconSearch, IconX, IconPin, IconPinFilled, IconBrandThin, IconArchive, IconArchiveArrowUp, IconTrash, IconUndo2,
    IconPalette, IconMoreVert, IconDownload, IconClock, IconHistory, IconRestore, IconCheck, IconNoteFile,
} from "icons.slint";

// ---------- Data ----------
export struct ChecklistItemData {
    line: int,
    text: string,
    checked: bool,
}

export struct NoteImageData {
    id: string,
    name: string,
    size-label: string,
    thumbnail: image,
}

export struct SearchMarkData {
    // UTF-8 byte offsets into the source text (matches TextInput's API).
    start: int,
    end: int,
}

export struct NoteData {
    id: string,
    title: string,
    title-highlighted: bool,
    title-styled: styled-text,
    title-marks: [SearchMarkData],
    preview: string,
    date-label: string,
    pinned: bool,
    favorite: bool,
    word-count: int,
    color-index: int,
    image-count: int,
    card-height: length,
    render-md: bool,
    preview-styled: styled-text,
    preview-has-link: bool,
    preview-linked: styled-text,
    preview-highlighted: bool,   // search-match spans present in preview-styled
    preview-marks: [SearchMarkData],
    checklist-items: [ChecklistItemData],
    is-checklist: bool,
    images: [NoteImageData],
}

// A transparent read-only TextInput whose selection paints exactly one web
// <mark> box. Slint 1.18 has no per-span backgrounds, but TextInput's
// selection uses the very same text layout, so stacking these over the plain
// text gives pixel-exact boxes at wrapped positions.
component SearchMarkLayer inherits TextInput {
    in property <string> source-text;
    in property <int> mark-start;
    in property <int> mark-end;
    in property <color> mark-fill;
    in property <length> mark-font-size;
    in property <int> mark-font-weight;
    in property <bool> mark-wrap;
    in property <float> mark-line-height;
    in property <TextVerticalAlignment> mark-align: top;

    // Captured exact glyph positions of the match's two ends. Slint fires
    // cursor-position-changed from set-selection-offsets, so the border uses
    // the very same layout as the selection fill.
    property <int> capture-step;
    property <length> edge-start-x;
    property <length> edge-start-y;
    property <length> edge-end-x;
    property <length> edge-end-y;

    x: 0;
    y: 0;
    width: 100%;
    height: 100%;
    text: source-text;
    font-size: mark-font-size;
    font-weight: mark-font-weight;
    wrap: mark-wrap ? word-wrap : no-wrap;
    single-line: false;
    line-height-factor: mark-line-height;
    vertical-alignment: mark-align;
    read-only: true;
    enabled: false;
    color: transparent;
    selection-foreground-color: transparent;
    selection-background-color: mark-fill;
    cursor-position-changed(pos) => {
        if (capture-step == 1) {
            edge-start-x = pos.x;
            edge-start-y = pos.y;
        }
        if (capture-step == 2) {
            edge-end-x = pos.x;
            edge-end-y = pos.y;
        }
    }
    init => {
        capture-step = 1;
        self.set-selection-offsets(mark-start, mark-start);
        capture-step = 2;
        self.set-selection-offsets(mark-end, mark-end);
        capture-step = 0;
        self.set-selection-offsets(mark-start, mark-end);
    }
    // Web mark.search-hl: 1px solid #F9AB00 border around the fill.
    Rectangle {
        x: min(edge-start-x, edge-end-x) - 1px;
        y: min(edge-start-y, edge-end-y) - 1px;
        width: abs(edge-end-x - edge-start-x) + 2px;
        height: abs(edge-end-y - edge-start-y) + mark-font-size * 1.5 + 2px;
        background: transparent;
        border-width: 1px;
        border-color: #F9AB00;
        visible: edge-end-x > 0;
    }
}

// Plain text plus one transparent selection layer per search match.
export component MarkedText inherits Rectangle {
    in property <string> source-text;
    in property <[SearchMarkData]> marks;
    in property <length> font-size: 12px;
    in property <int> font-weight: 400;
    in property <bool> wrap-words: true;
    in property <float> line-height: 1.5;
    in property <brush> text-color;
    in property <color> mark-fill;
    in property <TextVerticalAlignment> text-align: top;

    // Paint the boxes first, then the real text on top: the TextInput's own
    // glyphs are transparent, so only its selection rectangle is visible.
    for mark in root.marks:
        SearchMarkLayer {
            source-text: root.source-text;
            mark-start: mark.start;
            mark-end: mark.end;
            mark-fill: root.mark-fill;
            mark-font-size: root.font-size;
            mark-font-weight: root.font-weight;
            mark-wrap: root.wrap-words;
            mark-line-height: root.line-height;
            mark-align: root.text-align;
        }
    Text {
        x: 0;
        y: 0;
        width: root.width;
        // No fixed height: the wrapped preferred height is what the card
        // layout must measure. `height: root.height` collapsed this to a
        // single line and elided the preview mid-glyph (board search).
        text: root.source-text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        line-height-factor: root.line-height;
        color: root.text-color;
        wrap: root.wrap-words ? word-wrap : no-wrap;
        vertical-alignment: root.text-align;
    }
}

export struct GraphNodeData {
    id: string,
    title: string,
    x: length,
    y: length,
    radius: length,
    linked: int,
    active: bool,
    depth: float,
}

export struct GraphLinkData {
    id: string,
    commands: string,
    active: bool,
    depth: float,
}

export struct DoodleStrokeData {
    id: int,
    color: color,
    size: length,
    commands: string,
}

export struct FolderData {
    id: string,
    name: string,
    meta: string,
}

export struct TagData {
    name: string,
    meta: string,
}

// ---------- IconButton: circular hover button, holds any children ----------
export component IconButton inherits Rectangle {
    in property <length> size: 38px;
    in-out property <bool> selected: false;
    in-out property <bool> danger: false;
    callback clicked();

    width: size;
    height: size;
    border-radius: size / 4;
    background: root.selected
        ? Theme.icon-hover-bg
        : (ta.has-hover ? (root.danger ? Theme.danger-soft : Theme.icon-hover-bg) : transparent);
    animate background { duration: 130ms; easing: cubic-bezier(0.2, 0, 0, 1); }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            @children
        }
    }
}

// ---------- NoteCheckBox: web <input type=checkbox> geometry ----------
// Browser checkbox: 20px square (18px in settings, 15px on cards), centred
// Material check on --text-sec fill when on; std-widgets CheckBox misaligns.
export component NoteCheckBox inherits Rectangle {
    in property <bool> checked: false;
    in property <length> box-size: 20px;
    callback toggled();

    width: root.box-size;
    height: root.box-size;
    border-radius: 2px;
    background: root.checked ? Theme.text-dim : transparent;
    border-width: root.checked ? 0px : 2px;
    border-color: Theme.text-dim;
    animate background { duration: 120ms; easing: cubic-bezier(0.2, 0, 0, 1); }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }

    if root.checked:
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                IconCheck { stroke-color: #ffffff; preferred-width: root.box-size * 0.74; preferred-height: root.box-size * 0.74; }
            }
        }
}

// ---------- RailButton: left icon rail entry (icon + tiny label) ----------
export component RailButton inherits Rectangle {
    in property <string> label;
    in-out property <bool> selected: false;
    callback clicked();

    width: Theme.rail-width;
    height: 44px;

    box := Rectangle {
        x: 6px;
        y: 3px;
        width: parent.width - 12px;
        height: parent.height - 6px;
        border-radius: Theme.r-md;
        background: root.selected
            ? Theme.accent-soft
            : (ta.has-hover ? Theme.surface-2 : transparent);
        animate background { duration: 130ms; easing: cubic-bezier(0.2, 0, 0, 1); }

        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }

        VerticalLayout {
            padding: 6px;
            spacing: 2px;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                @children
            }
            Text {
                text: root.label;
                font-size: 9px;
                font-weight: 500;
                color: root.selected ? Theme.accent : Theme.text-dim;
                horizontal-alignment: center;
                wrap: no-wrap;
                overflow: elide;
            }
        }
    }
}

// ---------- RailRow: compact rail item (44px icon box, web .drawer-item collapsed) ----------
export component RailRow inherits Rectangle {
    in property <bool> selected: false;
    in property <bool> danger: false;
    callback clicked();

    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: root.selected
        ? Theme.drawer-active
        : (ta.has-hover ? (root.danger ? Theme.danger-soft : Theme.icon-hover-bg) : transparent);
    animate background { duration: 150ms; easing: cubic-bezier(0.2, 0, 0, 1); }

    ta := TouchArea {
        mouse-cursor: pointer;
        // Rows are separated by 2px in the drawer layout; extending the
        // TouchArea 1px past both ends keeps rail hover intact when the
        // stationary pointer ends up in a gap after the rail reflows on
        // expansion.
        y: -1px;
        height: parent.height + 2px;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            @children
        }
    }
}

// ---------- SidebarRow: folder/tag list rows ----------
export component SidebarRow inherits Rectangle {
    in property <string> label;
    in property <string> meta: "";          // right-aligned count
    in property <bool> show-delete: false;
    in property <bool> labels: true;        // rail expanded: show text; collapsed: icon only
    in-out property <bool> selected: false;
    callback clicked();
    callback delete();

    height: root.labels ? 52px : 44px;
    border-radius: root.labels ? 11px : 10px;
    background: root.selected
        ? Theme.drawer-active
        : (ta.has-hover ? Theme.icon-hover-bg : transparent);
    animate background { duration: 150ms; easing: cubic-bezier(0.2, 0, 0, 1); }

    ta := TouchArea {
        mouse-cursor: pointer;
        // Rows are separated by 2px in the drawer layout; extending the
        // TouchArea 1px past both ends keeps rail hover intact when the
        // stationary pointer ends up in a gap after the rail reflows on
        // expansion.
        y: -1px;
        height: parent.height + 2px;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: root.labels ? 14px : 10px;
        padding-right: root.labels ? 26px : 10px;
        spacing: root.labels ? 18px : 0px;
        alignment: root.labels ? start : center;

        VerticalLayout {
            alignment: center;
            @children
        }

        Text {
            visible: root.labels;
            text: root.label;
            font-size: 14px;
            font-weight: root.selected ? 500 : 400;
            color: root.selected ? Theme.text : Theme.text-dim;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
        }

        Rectangle {} // spring

        Text {
            visible: root.labels && root.meta != "" && !(root.show-delete && ta.has-hover);
            text: root.meta;
            font-size: 12px;
            color: Theme.text-faint;
            vertical-alignment: center;
        }

        if root.labels && root.show-delete && ta.has-hover:
            IconButton {
                size: 24px;
                clicked => { root.delete(); }
                IconX { stroke-color: Theme.text-faint; preferred-width: 13px; preferred-height: 13px; }
            }
    }
}

// ---------- SearchBar ----------
export component SearchBar inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "Search your notes";
    in-out property <int> focus-token: 0;
    callback submitted();
    callback cleared();

    public function input-focus() {
        input.focus();
    }

    changed focus-token => { input.focus(); }

    height: 52px;
    border-radius: 10px;
    background: input.has-focus ? (Theme.dark ? Theme.surface-3 : #FFFFFF) : Theme.surface-2;
    border-width: 0px;
    animate background { duration: 150ms; easing: cubic-bezier(0.2, 0, 0, 1); }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;

        Rectangle {
            width: 28px;
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    IconSearch { stroke-color: Theme.icon; preferred-width: 22px; preferred-height: 22px; }
                }
            }
        }

        input := TextInput {
            horizontal-stretch: 1;
            font-size: 16px;
            font-weight: 400;
            color: Theme.text;
            vertical-alignment: center;
            selection-background-color: Theme.mark-bg;
            selection-foreground-color: Theme.text;
            single-line: true;
            edited => { root.submitted(); }
            key-pressed(event) => {
                if event.text == "\n" {
                    root.submitted();
                    return accept;
                }
                reject
            }
        }

        Rectangle {
            width: 36px;
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    IconButton {
                        visible: root.text != "";
                        size: 32px;
                        clicked => { root.text = ""; root.cleared(); }
                        IconX { stroke-color: Theme.icon; preferred-width: 18px; preferred-height: 18px; }
                    }
                }
            }
        }
    }

    // Placeholder
    Text {
        visible: root.text == "";
        x: 44px;
        width: parent.width - 60px;
        height: 100%;
        vertical-alignment: center;
        text: root.placeholder;
        font-size: 16px;
        color: Theme.placeholder;
        wrap: no-wrap;
        overflow: elide;
    }
}

// ---------- Input (styled single-line) ----------
export component Input inherits Rectangle {
    in-out property <string> text <=> input.text;
    in-out property <bool> edited: false;
    in property <string> placeholder: "";
    in property <string> font-family: "";
    callback submitted();

    height: 34px;
    background: transparent;

    input := TextInput {
        width: 100%;
        height: 100%;
        font-size: 15px;
        font-family: root.font-family == "" ? "Inter" : root.font-family;
        color: Theme.text;
        vertical-alignment: center;
        selection-background-color: Theme.accent-soft;
        selection-foreground-color: Theme.text;
        single-line: true;
        edited => { root.edited = true; }
        key-pressed(event) => {
            if event.text == "\n" { root.submitted(); return accept; }
            reject
        }
    }

    Text {
        visible: input.text == "";
        text: root.placeholder;
        font-size: 15px;
        color: Theme.text-faint;
        vertical-alignment: center;
        wrap: no-wrap;
    }
}

// ---------- CardActions: shared hover action row for NoteCard ----------
// Web .card-actions order/count: pin · color · archive · trash · more
// (archive view: unarchive · color · export · trash · more;
// trash view: restore · delete-forever · more). Guards live on
// actions-visible (card hover | popover open), applied by the caller.
export component CardActions inherits HorizontalLayout {
    in property <int> active-view: 0;
    in property <bool> pinned: false;
    in property <int> density: 1;   // web --card-act: 28/32/36, phone 30
    in property <bool> compact: false;
    private property <length> act-size: root.compact ? 30px : root.density == 0 ? 28px : root.density == 2 ? 36px : 32px;
    private property <length> act-ico: root.compact ? 16px : root.density == 0 ? 16px : root.density == 2 ? 18px : 17px;
    in-out property <bool> actions-visible: true;
    in-out property <bool> color-open: false;
    in-out property <bool> more-open: false;
    callback pin-toggled();
    callback archive-toggled();
    callback trash-toggled();
    callback restore-toggled();
    callback delete-forever();
    callback export-toggled();

    spacing: root.compact ? 3px : 4px;
    opacity: root.actions-visible ? 1.0 : 0.0;
    animate opacity { duration: 120ms; easing: cubic-bezier(0.2, 0, 0, 1); }
            if root.active-view == 4:
                HorizontalLayout {
                    spacing: 4px;
                    IconButton {
                        size: root.act-size;
                        clicked => { if root.actions-visible { root.restore-toggled(); } }
                        IconRestore { stroke-color: Theme.icon; preferred-width: root.act-ico; preferred-height: root.act-ico; }
                    }
                    IconButton {
                        size: root.act-size;
                        danger: true;
                        clicked => { if root.actions-visible { root.delete-forever(); } }
                        IconTrash { stroke-color: Theme.danger; preferred-width: root.act-ico; preferred-height: root.act-ico; }
                    }
                }
            if root.active-view == 3:
                HorizontalLayout {
                    spacing: 4px;
                    IconButton {
                        size: root.act-size;
                        clicked => { if root.actions-visible { root.archive-toggled(); } }
                        IconArchiveArrowUp { stroke-color: Theme.icon; preferred-width: root.act-ico; preferred-height: root.act-ico; }
                    }
                    IconButton {
                        size: root.act-size;
                        clicked => { if root.actions-visible { root.more-open = false; root.color-open = !root.color-open; } }
                        IconPalette { stroke-color: Theme.icon; preferred-width: root.act-ico; preferred-height: root.act-ico; }
                    }
                    IconButton {
                        size: root.act-size;
                        clicked => { if root.actions-visible { root.export-toggled(); } }
                        IconDownload { stroke-color: Theme.icon; preferred-width: root.act-ico; preferred-height: root.act-ico; }
                    }
                    IconButton {
                        size: root.act-size;
                        clicked => { if root.actions-visible { root.trash-toggled(); } }
                        IconTrash { stroke-color: Theme.icon; preferred-width: root.act-ico; preferred-height: root.act-ico; }
                    }
                }
            if root.active-view != 3 && root.active-view != 4:
                HorizontalLayout {
                    spacing: 4px;
                    IconButton {
                        size: root.act-size;
                        clicked => { if root.actions-visible { root.pin-toggled(); } }
                        if root.pinned:
                            IconPinFilled { stroke-color: Theme.text; preferred-width: root.act-ico; preferred-height: root.act-ico; }
                        if !root.pinned:
                            IconPin { stroke-color: Theme.icon; preferred-width: root.act-ico; preferred-height: root.act-ico; }
                    }
                    IconButton {
                        size: root.act-size;
                        clicked => { if root.actions-visible { root.more-open = false; root.color-open = !root.color-open; } }
                        IconPalette { stroke-color: Theme.icon; preferred-width: root.act-ico; preferred-height: root.act-ico; }
                    }
                    IconButton {
                        size: root.act-size;
                        clicked => { if root.actions-visible { root.archive-toggled(); } }
                        IconArchive { stroke-color: Theme.icon; preferred-width: root.act-ico; preferred-height: root.act-ico; }
                    }
                    IconButton {
                        size: root.act-size;
                        clicked => { if root.actions-visible { root.trash-toggled(); } }
                        IconTrash { stroke-color: Theme.icon; preferred-width: root.act-ico; preferred-height: root.act-ico; }
                    }
                }
            IconButton {
                size: root.act-size;
                clicked => { if root.actions-visible { root.color-open = false; root.more-open = !root.more-open; } }
                IconMoreVert { stroke-color: Theme.icon; preferred-width: root.act-ico; preferred-height: root.act-ico; }
            }
}

// ---------- NoteCard ----------
export component NoteCard inherits Rectangle {
    in property <NoteData> note;
    in property <bool> compact: false;
    in property <int> density: 1;   // web body[data-density]: 0 compact · 1 cozy · 2 roomy
    in property <int> preview-lines: 5;
    in property <bool> show-date: true;
    in property <int> active-view: 0;   // 0 all · 1 pinned · 2 fav · 3 archive · 4 trash
    in-out property <bool> selected: false;
    in property <bool> fixed-height: false;   // Keep style: exact 170px like the webapp
    in property <bool> drag-enabled: false;
    in property <bool> drag-active: false;    // this card is the one being dragged (render as placeholder)
    callback clicked();
    callback double-clicked();
    callback pin-toggled();
    callback archive-toggled();
    callback trash-toggled();
    callback restore-toggled();
    callback delete-forever();
    callback export-toggled();
    callback card-color-picked(int);
    callback card-timestamps();
    callback checklist-item-toggled(int);
    callback drag-begin(string, length, length, length, length);  // id, pointer abs x/y, card abs x/y
    callback drag-move(length, length);
    callback drag-finish(length, length);

    // Web density tokens (--card-pad/--card-title/--card-body/--card-check).
    // Phones override all densities (web @720px block).
    private property <length> tok-pad-x: root.compact ? 13px : root.density == 0 ? 12px : root.density == 2 ? 22px : 18px;
    private property <length> tok-pad-t: root.compact ? 11px : root.density == 0 ? 10px : root.density == 2 ? 18px : 14px;
    private property <length> tok-pad-b: root.compact ? 7px : root.density == 0 ? 6px : root.density == 2 ? 13px : 10px;
    private property <length> tok-title: root.compact ? 14.5px : root.density == 0 ? 14px : root.density == 2 ? 18.5px : 16.5px;
    private property <length> tok-body: root.compact ? 11px : root.density == 0 ? 11px : root.density == 2 ? 13.5px : 12px;
    private property <length> tok-check: root.compact ? 14px : root.density == 0 ? 13px : root.density == 2 ? 17px : 15px;
    // (web cards render no image strip — only the "N images" count)
    private property <bool> pressed: false;
    private property <bool> suppress-click: false;
    private property <bool> color-open: false;
    private property <bool> more-open: false;
    private property <length> start-mouse-x: 0px;
    private property <length> start-mouse-y: 0px;
    private property <bool> dragging: false;

    height: root.compact ? 68px : (root.fixed-height ? 170px : root.note.card-height);
    border-radius: root.compact ? 8px : Theme.neo ? 14px : Theme.r-md;
    // Web parity: uncoloured notes have no fill (they read as the page);
    // coloured notes carry their fill and no border. The drag ghost adds
    // a fill back for the floating copy (see note-grid).
    background: Theme.neo ? Theme.neo-card : (root.compact && ta.has-hover && root.note.color-index == 0 ? Theme.surface-2 : (root.note.color-index == 0 ? transparent : Theme.note-color(root.note.color-index)));
    border-width: (Theme.neo || root.compact) ? 0px : ((root.drag-active || root.selected) ? 1px : (root.note.color-index == 0 ? 1px : 0px));
    border-color: root.drag-active ? Theme.accent : (root.selected ? Theme.accent : (ta.has-hover ? Theme.border-strong : Theme.border));
    animate background { duration: 130ms; }
    animate border-color { duration: 130ms; }
    drop-shadow-blur: root.drag-active ? 0px : Theme.neo ? 28px : (ta.has-hover ? 24px : 12px);
    drop-shadow-offset-y: root.drag-active ? 0px : Theme.neo ? 10px : (ta.has-hover ? 4px : 2px);
    drop-shadow-color: Theme.neo ? #00000090 : #00000040;
    animate drop-shadow-blur { duration: 160ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    animate drop-shadow-offset-y { duration: 160ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    opacity: root.drag-active ? 0.0 : 1.0;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if root.suppress-click { root.suppress-click = false; return; }
            root.color-open = false; root.more-open = false; root.clicked();
        }
        double-clicked => { root.double-clicked(); }
        pointer-event(event) => {
            if !root.drag-enabled { return EventResult.reject; }
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.pressed = true;
                root.dragging = false;
                root.suppress-click = false;
                root.start-mouse-x = self.mouse-x;
                root.start-mouse-y = self.mouse-y;
                return EventResult.accept;
            }
            if event.kind == PointerEventKind.move {
                if root.pressed {
                    if !root.dragging {
                        if abs(self.mouse-x - root.start-mouse-x) > 7px || abs(self.mouse-y - root.start-mouse-y) > 7px {
                            root.dragging = true;
                            root.suppress-click = true;
                            root.drag-begin(root.note.id,
                                self.absolute-position.x + self.mouse-x,
                                self.absolute-position.y + self.mouse-y,
                                self.absolute-position.x,
                                self.absolute-position.y);
                        }
                    } else {
                        root.drag-move(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
                return EventResult.accept;
            }
            if event.kind == PointerEventKind.up {
                if root.pressed && root.dragging {
                    root.drag-finish(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
                root.pressed = false;
                root.dragging = false;
                return EventResult.accept;
            }
            return EventResult.reject;
        }

    VerticalLayout {
        visible: !root.compact;
        y: 0px;
        width: 100%;
        height: root.height;
        padding-left: root.compact ? 12px : root.tok-pad-x;
        padding-right: root.compact ? 12px : root.tok-pad-x;
        padding-top: root.compact ? 8px : root.tok-pad-t;
        padding-bottom: root.compact ? 6px : root.tok-pad-b;
        spacing: root.compact ? 4px : 6px;

        // Title row: web shows only a solid pin badge top-right for pinned
        // notes; the pin button lives in the bottom actions row.
        HorizontalLayout {
            spacing: 8px;
            // Search mode: web wraps matched title runs in <mark>. Stacked
            // transparent TextInput selections paint the fill at Slint's
            // exact wrapped positions, preserving the title's typography.
            if root.note.title-highlighted:
                MarkedText {
                    horizontal-stretch: 1;
                    source-text: root.note.title;
                    marks: root.note.title-marks;
                    font-size: root.tok-title;
                    font-weight: 500;
                    wrap-words: !root.compact;
                    line-height: 1.4;
                    text-color: Theme.card-title-ink;
                    mark-fill: Theme.mark-bg;
                    text-align: center;
                }
            if !root.note.title-highlighted:
                Text {
                    horizontal-stretch: 1;
                    text: root.note.title == "" ? "Untitled" : root.note.title;
                    font-size: root.tok-title;
                    font-weight: 500;
                    line-height-factor: 1.4;
                    color: root.note.title == "" ? Theme.text-faint : Theme.card-title-ink;
                    font-italic: root.note.title == "";
                    // Web .note-title h3: white-space: pre-wrap — titles wrap,
                    // never ellipsis (Compact keeps the single-line row).
                    wrap: root.compact ? no-wrap : word-wrap;
                    overflow: elide;
                    vertical-alignment: center;
                }
            if root.note.pinned:
                VerticalLayout {
                    alignment: center;
                    IconPinFilled { stroke-color: Theme.icon; preferred-width: 15px; preferred-height: 15px; }
                }
        }

        // Search marks take precedence over the markdown-in-cards setting:
        // web shows raw text with <mark> boxes in search results.
        if !root.note.is-checklist && root.note.preview-highlighted:
            MarkedText {
                horizontal-stretch: 1;
                vertical-stretch: root.compact ? 0 : 1;
                source-text: root.note.preview;
                marks: root.note.preview-marks;
                font-size: root.tok-body;
                font-weight: 400;
                wrap-words: !root.compact;
                line-height: 1.5;
                text-color: Theme.card-body-ink;
                mark-fill: Theme.mark-bg;
            }
        if !root.note.is-checklist && root.note.render-md && !root.note.preview-highlighted:
            StyledText {
                text: root.note.preview-styled;
                default-font-size: root.tok-body;
                default-color: Theme.card-body-ink;
                link-color: Theme.accent;
                max-lines: root.preview-lines <= 0 ? 0 : root.preview-lines;
                vertical-stretch: 1;
            }
        if root.note.is-checklist && !root.note.render-md:
            VerticalLayout {
                spacing: 5px;
                for item[i] in root.note.checklist-items:
                    HorizontalLayout {
                            visible: !root.compact || i == 0;
                            spacing: 6px;
                            VerticalLayout {
                                padding-top: 2px;
                                NoteCheckBox { box-size: root.tok-check; checked: item.checked; toggled => { root.checklist-item-toggled(item.line); } }
                            }
                            Text {
                                text: item.text;
                                font-size: root.tok-body;
                                font-weight: 400;
                                line-height-factor: 1.5;
                                color: item.checked ? Theme.text-faint : Theme.card-body-ink;
                                wrap: word-wrap;
                                overflow: elide;
                                vertical-alignment: top;
                                horizontal-stretch: 1;
                            }
                        }
            }
        if !root.note.is-checklist && root.note.preview-has-link && !root.note.render-md && !root.note.preview-highlighted:
            // Web linkifies raw URLs even in raw previews (blue link text).
            StyledText {
                text: root.note.preview-linked;
                default-font-size: root.tok-body;
                default-color: Theme.card-body-ink;
                link-color: Theme.accent;
                max-lines: 0;
                vertical-stretch: 1;
            }
        if !root.note.is-checklist && !root.note.render-md && !root.note.preview-highlighted && !root.note.preview-has-link:
            Text {
                width: 100%;
                // No fixed height here: with vertical-stretch the layout gives
                // this Text its full wrapped height (a fixed height made the
                // layout compress it and Slint elided the last line mid-word).
                vertical-stretch: root.compact ? 0 : 1;
                text: root.note.preview;
                font-size: root.tok-body;
                font-weight: 400;
                line-height-factor: 1.5;
                color: Theme.card-body-ink;
                wrap: root.compact ? no-wrap : word-wrap;
                overflow: elide;
                vertical-alignment: top;
            }

        Rectangle {} // spring

        // date / count row (web .note-date sits above .card-actions)
        if !root.compact && (root.show-date || root.note.image-count > 0):
            HorizontalLayout {
                spacing: 8px;

                if root.show-date:
                    Text {
                        text: root.note.date-label;
                        font-size: 11.5px;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                    }

                if root.note.image-count > 0:
                    Text {
                        text: root.note.image-count + " image" + (root.note.image-count == 1 ? "" : "s");
                        font-size: 11.5px;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                    }
            }

        if root.compact:
            HorizontalLayout {
                spacing: 8px;
                if root.show-date:
                    Text {
                        text: root.note.date-label;
                        font-size: 11.5px;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                    }
                if root.note.image-count > 0:
                    Text {
                        text: root.note.image-count + " image" + (root.note.image-count == 1 ? "" : "s");
                        font-size: 11.5px;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                    }
                Rectangle {}
                CardActions {
                    active-view: root.active-view;
                    pinned: root.note.pinned;
                    density: root.density;
                    compact: root.compact;
                    actions-visible: ta.has-hover || root.color-open || root.more-open;
                    color-open <=> root.color-open;
                    more-open <=> root.more-open;
                    pin-toggled => { root.pin-toggled(); }
                    archive-toggled => { root.archive-toggled(); }
                    trash-toggled => { root.trash-toggled(); }
                    restore-toggled => { root.restore-toggled(); }
                    delete-forever => { root.delete-forever(); }
                    export-toggled => { root.export-toggled(); }
                }
            }

        if !root.compact:
            CardActions {
                active-view: root.active-view;
                pinned: root.note.pinned;
                density: root.density;
                compact: root.compact;
                actions-visible: ta.has-hover || root.color-open || root.more-open;
                color-open <=> root.color-open;
                more-open <=> root.more-open;
                pin-toggled => { root.pin-toggled(); }
                archive-toggled => { root.archive-toggled(); }
                trash-toggled => { root.trash-toggled(); }
                restore-toggled => { root.restore-toggled(); }
                delete-forever => { root.delete-forever(); }
                export-toggled => { root.export-toggled(); }
            }
    }



    // Row mode (web .note-row): glyph + title/snippet + side date/actions,
    // borderless with a bottom hairline, hover = --bar-bg.
    if root.compact:
        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 12px;
            Rectangle {
                width: 22px;
                height: 22px;
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        if root.note.pinned:
                            IconPinFilled { stroke-color: Theme.text; preferred-width: 18px; preferred-height: 18px; }
                        if !root.note.pinned:
                            IconNoteFile { stroke-color: Theme.icon; preferred-width: 18px; preferred-height: 18px; }
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: root.note.title == "" ? "Untitled" : root.note.title;
                    font-size: 15px;
                    font-weight: 500;
                    color: root.note.title == "" ? Theme.text-faint : Theme.card-title-ink;
                    font-italic: root.note.title == "";
                    wrap: no-wrap;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Text {
                    text: root.note.preview;
                    font-size: 12.5px;
                    color: Theme.text-dim;
                    wrap: no-wrap;
                    overflow: elide;
                    height: 18px;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                if root.show-date:
                    Text {
                        text: root.note.date-label;
                        font-size: 12px;
                        color: Theme.text-dim;
                        horizontal-alignment: right;
                    }
                CardActions {
                    active-view: root.active-view;
                    pinned: root.note.pinned;
                    density: root.density;
                    compact: root.compact;
                    actions-visible: ta.has-hover || root.color-open || root.more-open;
                    color-open <=> root.color-open;
                    more-open <=> root.more-open;
                    pin-toggled => { root.pin-toggled(); }
                    archive-toggled => { root.archive-toggled(); }
                    trash-toggled => { root.trash-toggled(); }
                    restore-toggled => { root.restore-toggled(); }
                    delete-forever => { root.delete-forever(); }
                    export-toggled => { root.export-toggled(); }
                }
            }
        }
    if root.compact:
        Rectangle { x: 0px; y: root.height - 1px; width: 100%; height: 1px; background: Theme.divider; }

    // (Web cards show no image strip; the "N images" count carries it.)

    // ===== colour popover (web #color-pop: 6x2 dots) =====
    if root.color-open:
        Rectangle {
            x: -6px;
            y: max(4px, root.height - 106px);
            width: 278px;
            height: 106px;
            background: Theme.surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 28px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000060;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    for idx[i] in [0, 1, 2, 3, 4, 5]:
                        TouchArea {
                            width: 31px;
                            height: 31px;
                            mouse-cursor: pointer;
                            clicked => { root.color-open = false; root.card-color-picked(idx); }
                            Rectangle {
                                width: 31px;
                                height: 31px;
                                border-radius: 8px;
                                background: idx == 0 ? Theme.card-bg : Theme.note-color(idx);
                                border-width: root.note.color-index == idx ? 2px : 1px;
                                border-color: root.note.color-index == idx ? Theme.text : Theme.border;
                            }
                        }
                }
                HorizontalLayout {
                    spacing: 12px;
                    for idx[i] in [6, 7, 8, 9, 10, 11]:
                        TouchArea {
                            width: 31px;
                            height: 31px;
                            mouse-cursor: pointer;
                            clicked => { root.color-open = false; root.card-color-picked(idx); }
                            Rectangle {
                                width: 31px;
                                height: 31px;
                                border-radius: 8px;
                                background: Theme.note-color(idx);
                                border-width: root.note.color-index == idx ? 2px : 1px;
                                border-color: root.note.color-index == idx ? Theme.text : Theme.border;
                            }
                        }
                }
            }
        }

    // ===== more popover (web #more-pop: min 198, rows 14px/20px icons) =====
    if root.more-open:
        Rectangle {
            x: -6px;
            y: max(4px, root.height - 108px);
            width: 198px;
            height: 100px;
            background: Theme.surface;
            border-radius: 5px;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 28px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000060;
            VerticalLayout {
                padding: 8px;
                spacing: 4px;
                Rectangle {
                    height: 40px;
                    border-radius: 5px;
                    background: tam.has-hover ? Theme.icon-hover-bg : transparent;
                    tam := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.more-open = false; root.archive-toggled(); }
                    }
                    HorizontalLayout {
                        padding-left: 13px;
                        spacing: 13px;
                        if root.active-view == 3:
                            IconArchiveArrowUp { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; }
                        if root.active-view != 3:
                            IconArchive { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; }
                        Text { text: root.active-view == 3 ? "Unarchive" : "Archive"; font-size: 14px; color: Theme.text; }
                    }
                }
                Rectangle {
                    height: 40px;
                    border-radius: 5px;
                    background: tts.has-hover ? Theme.icon-hover-bg : transparent;
                    tts := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.more-open = false; root.card-timestamps(); }
                    }
                    HorizontalLayout {
                        padding-left: 13px;
                        spacing: 13px;
                        IconHistory { stroke-color: Theme.icon; preferred-width: 20px; preferred-height: 20px; }
                        Text { text: "Timestamps"; font-size: 14px; color: Theme.text; }
                    }
                }
            }
        }
    }
}

// ---------- TextButton ----------
export component TextButton inherits Rectangle {
    in property <string> label;
    in-out property <bool> emphasis: false;
    in-out property <bool> danger: false;
    in property <bool> text-only: false; // web .btn-text: transparent bg, text-sec ink, 500 14px
    in property <length> btn-h: 0px; // web overrides (auth-actions 44px)
    callback clicked();

    height: root.btn-h > 0px ? root.btn-h : root.text-only ? 40px : 38px;
    min-width: root.text-only ? 0px : 76px;
    horizontal-stretch: 0;
    border-radius: root.text-only ? 9px : 9px;
    background: root.text-only
        ? (ta.has-hover ? Theme.icon-hover-bg : transparent)
        : root.danger
            ? (ta.has-hover ? Theme.danger-soft : Theme.danger-soft)
            : (root.emphasis
                ? (ta.has-hover ? (Theme.dark ? #2A2B2D : #F1F3F4) : (Theme.dark ? #1F1F1F : #FFFFFF))
                : (ta.has-hover ? Theme.surface-3 : Theme.surface-2));
    border-width: root.emphasis ? 1px : 0px;
    border-color: Theme.border;
    animate background { duration: 150ms; easing: cubic-bezier(0.2, 0, 0, 1); }

    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }

    VerticalLayout {
        alignment: center;
        padding-left: root.text-only ? 17px : 16px;
        padding-right: root.text-only ? 17px : 16px;
        Text {
            text: root.label;
            font-size: root.text-only ? 14px : 13.5px;
            font-weight: root.text-only ? 500 : 600;
            color: root.danger ? Theme.danger : (root.text-only ? (ta.has-hover ? Theme.text : Theme.text-dim) : (root.emphasis ? (Theme.dark ? #E8EAED : #3C4043) : Theme.text));
            horizontal-alignment: center;
        }
    }
}

// ---------- ConfirmDialog ----------
export component ConfirmDialog inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> confirm-label: "Delete";
    in property <bool> danger: true;
    callback confirmed();
    callback cancelled();

    width: 100%;
    height: 100%;

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.scrim;
        TouchArea { clicked => { root.cancelled(); } }
    }

    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 60px;
        width: min(400px, parent.width - 48px);
        height: layout.preferred-height;
        border-radius: Theme.r-lg;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000060;

        layout := VerticalLayout {
            padding: 22px;
            spacing: 10px;

            Text {
                text: root.title;
                font-size: 16.5px;
                font-weight: 600;
                color: Theme.text;
            }
            Text {
                text: root.message;
                font-size: 13.5px;
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            Rectangle { height: 4px; }
            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                TextButton { label: "Cancel"; clicked => { root.cancelled(); } }
                TextButton { label: root.confirm-label; danger: root.danger; emphasis: !root.danger; clicked => { root.confirmed(); } }
            }
        }
    }
}

// ---------- Toast ----------
export component Toast inherits Rectangle {
    in property <string> message;

    height: 48px;
    border-radius: 12px;
    background: #323639;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000050;

    VerticalLayout {
        alignment: center;
        padding-left: 26px;
        padding-right: 26px;
        Text {
            text: root.message;
            font-size: 14px;
            color: #E8EAED;
        }
    }
}

// ---------- EmptyState ----------
export component EmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle: "";
    alignment: center;
    spacing: 8px;

    HorizontalLayout {
        alignment: center;
        IconBrandThin {
            preferred-width: 72px;
            preferred-height: 72px;
            opacity: 0.22;
            stroke-color: Theme.text-dim;
        }
    }
    Text {
        text: root.title;
        font-size: 14px;
        color: Theme.text-dim;
        horizontal-alignment: center;
    }
    Text {
        visible: root.subtitle != "";
        text: root.subtitle;
        font-size: 14px;
        color: Theme.text-dim;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

// ---------- Divider ----------
export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

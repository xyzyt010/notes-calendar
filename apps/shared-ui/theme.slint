// Shared design tokens for the yellod apps (Notes & Calendar).
// Import this file, then reference Theme.* anywhere.

import "../../assets/fonts/Inter-Regular.ttf";
import "../../assets/fonts/Inter-Medium.ttf";
import "../../assets/fonts/Inter-SemiBold.ttf";
import "../../assets/fonts/Inter-Bold.ttf";
import "../../assets/fonts/Inter-Light.ttf";
import "../../assets/fonts/Inter-Italic.ttf";
import "../../assets/fonts/Inter-SemiBoldItalic.ttf";
import "../../assets/fonts/Inter-MediumItalic.ttf";

export global Theme {
    // Master switch. Toggled from settings; everything derives from it.
    in-out property <bool> dark: true;
    in-out property <bool> neo: false;

    // ---- Backgrounds (Google Keep — matches the deployed site exactly) ----
    out property <color> bg:            neo ? #202124 : (dark ? #121212 : #FFFFFF);
    out property <color> surface:       neo ? #202124 : (dark ? #1B1B1B : #F1F3F4);
    out property <color> surface-2:     neo ? #23262D : (dark ? #2A2B2D : #F1F3F4);
    out property <color> surface-3:     neo ? #2A2D34 : (dark ? #333639 : #E8EAED);
    out property <color> card-bg:       neo ? #202124 : (dark ? #1F1F1F : #FFFFFF);  // cards & composer
    out property <color> neo-card:      #202124;
    out property <color> neo-raised:    #23262D;
    out property <color> neo-inset:     #14161A;
    out property <color> border:        dark ? #5F6368 : #DDDDDD;
    out property <color> border-strong: dark ? #5F6368 : #C7C9CC;
    out property <color> divider:       dark ? #2C2D2F : #E8EAED;  // hairline separators
    out property <color> icon-hover-bg: dark ? rgba(255,255,255,0.10) : rgba(95,99,104,0.08);
    out property <color> drawer-bg:     neo ? #202124 : (dark ? #1B1B1B : #FFFFFF);
    out property <color> drawer-active: dark ? #47484C : #FDD663;

    out property <color> scrim:         dark ? #00000099 : rgba(32,33,36,0.4);   // modal overlay

    // ---- Text ----
    out property <color> text:          dark ? #e8eaed : #1f2022;
    out property <color> text-dim:      dark ? #9aa0a6 : #5f6368;
    out property <color> text-faint:    dark ? #8a919c : #a3a7ad;
    out property <color> card-title-ink: dark ? #ffffff : #202124;  // --card-title-ink
    out property <color> card-body-ink:  dark ? #c7ccd1 : #5f6368;  // --card-body-ink
    out property <color> icon:          dark ? #a7aab0 : #5f6368;   // --icon, exact
    out property <color> placeholder:   dark ? #9aa0a6 : #70757a;   // --placeholder, exact

    // ---- Accent (notes.yellod.dpdns.org blue) ----
    out property <color> accent:        dark ? #AECBFA : #1A73E8;
    out property <color> on-accent:     dark ? #0B326E : #FFFFFF;
    out property <color> accent-soft:   dark ? #AECBFA29 : #1A73E81F; // ~16% / ~12%

    out property <color> danger:        dark ? #F28B82 : #D93025;   // Keep danger
    out property <color> danger-soft:   dark ? #f2b8b520 : #b3261a12;

    out property <color> success:       dark ? #9ad3a8 : #146c2e;

    // ---- Note color palette (exact notes.yellod.dpdns.org dark set) ----
    out property <color> n-default:  dark ? #1F1F1F : #FFFFFF;
    out property <color> n-red:      dark ? #5C2B29 : #F28B82;
    out property <color> n-orange:   dark ? #614A19 : #FBBC04;
    out property <color> n-yellow:   dark ? #635D18 : #FFF475;
    out property <color> n-green:    dark ? #345920 : #CCFF90;
    out property <color> n-cyan:     dark ? #16504B : #A7FFEB;
    out property <color> n-darkblue: dark ? #1E3A5F : #AECBFA;
    out property <color> n-lightblue:dark ? #2D555E : #CBF0F8;
    out property <color> n-purple:   dark ? #42275E : #D7AEFB;
    out property <color> n-pink:     dark ? #5B2245 : #FDCFE8;
    out property <color> n-brown:    dark ? #442F19 : #E6C9A8;
    out property <color> n-grey:     dark ? #2C2D2F : #E8EAED;
    out property <color> card-surface: dark ? #1F1F1F : #FFFFFF;

    pure public function note-color(idx: int) -> color {
        if idx == 1 { return Theme.n-red; }
        if idx == 2 { return Theme.n-orange; }
        if idx == 3 { return Theme.n-yellow; }
        if idx == 4 { return Theme.n-green; }
        if idx == 5 { return Theme.n-cyan; }
        if idx == 6 { return Theme.n-darkblue; }
        if idx == 7 { return Theme.n-lightblue; }
        if idx == 8 { return Theme.n-purple; }
        if idx == 9 { return Theme.n-pink; }
        if idx == 10 { return Theme.n-brown; }
        if idx == 11 { return Theme.n-grey; }
        return Theme.n-default;
    }

    // ---- Radius scale ----
    out property <length> r-sm: 8px;
    out property <length> r-md: 12px;
    out property <length> r-lg: 16px;
    out property <length> r-xl: 24px;

    // ---- Layout ----
    out property <length> rail-width: 72px;
    out property <length> sidebar-width: 264px;
    out property <length> topbar-height: 64px;

    // ---- Elevation (fake, layered translucency — cheap & looks right) ----
    out property <brush> card-shadow: dark
        ? @linear-gradient(180deg, #ffffff08 0%, #00000055 100%)
        : @linear-gradient(180deg, #00000000 0%, #00000014 100%);
}
